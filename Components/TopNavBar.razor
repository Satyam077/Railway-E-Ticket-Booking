@using Microsoft.AspNetCore.Components.Authorization
@using Railway_Ticket_Booking.Infrastructure.Services
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

    <nav class="navbar navbar-expand-lg navbar-dark shadow-lg sticky-top" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); backdrop-filter: blur(10px); border-bottom: 3px solid rgba(255, 255, 255, 0.2);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));">
                <img src="logo.png" alt="Railway Booking Logo" style="height: 45px; margin-right: 12px; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" />
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(10px);">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold px-3 py-2 rounded-3 mx-1" href="/" style="transition: all 0.3s ease; background: rgba(255,255,255,0.1);" onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='translateY(0)'">
                            <i class="fas fa-home me-2"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold px-3 py-2 rounded-3 mx-1" href="/" style="transition: all 0.3s ease; background: rgba(255,255,255,0.1);" onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='translateY(0)'">
                            <i class="fas fa-search me-2"></i>Search Trains
                        </a>
                    </li>
                    @if (isAuthenticated)
                    {
                        @if (userRole == "Customer")
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold px-3 py-2 rounded-3 mx-1" href="/user-dashboard" style="transition: all 0.3s ease; background: rgba(255,255,255,0.1);" onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='translateY(0)'">
                                    <i class="fas fa-tachometer-alt me-2"></i>My Dashboard
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3 py-2 rounded-3 mx-1" href="/my-bookings" style="transition: all 0.3s ease; background: rgba(255,255,255,0.1);" onmouseover="this.style.background='rgba(255,255,255,0.25)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'; this.style.transform='translateY(0)'">
                                <i class="fas fa-ticket-alt me-2"></i>My Bookings
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center px-3 py-2 rounded-3" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); transition: all 0.3s ease;" onmouseover="this.style.background='rgba(255,255,255,0.25)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
                                <div class="me-2">
                                    <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 38px; height: 38px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important;">
                                        <i class="fas fa-user" style="color: white;"></i>
                                    </div>
                                </div>
                                <div class="d-none d-md-block text-start">
                                    <div class="fw-bold" style="font-size: 0.9rem; text-shadow: 0 1px 2px rgba(0,0,0,0.2);">@userName</div>
                                    <div class="text-white-50" style="font-size: 0.75rem;">@userRole</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="userDropdown" style="background: rgba(255,255,255,0.98); backdrop-filter: blur(15px); border-radius: 15px; padding: 0.5rem;">
                                <li>
                                    <div class="dropdown-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 10px; margin: 0.25rem; padding: 0.75rem;">
                                        <div class="fw-bold text-white">@userName</div>
                                        <small class="text-white-50">@userEmail</small>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider" style="margin: 0.5rem 0;"></li>
                                <li>
                                    <a class="dropdown-item rounded-3 mx-2 my-1" href="/profile" style="transition: all 0.3s ease;" onmouseover="this.style.background='linear-gradient(135deg, #667eea 0%, #764ba2 100%)'; this.style.color='white'" onmouseout="this.style.background='transparent'; this.style.color='inherit'">
                                        <i class="fas fa-user-circle me-2"></i>View Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 mx-2 my-1" href="/my-bookings" style="transition: all 0.3s ease;" onmouseover="this.style.background='linear-gradient(135deg, #667eea 0%, #764ba2 100%)'; this.style.color='white'" onmouseout="this.style.background='transparent'; this.style.color='inherit'">
                                        <i class="fas fa-ticket-alt me-2"></i>My Bookings
                                    </a>
                                </li>
                                @if (userRole == "Admin" || userRole == "SuperAdmin")
                                {
                                    <li><hr class="dropdown-divider" style="margin: 0.5rem 0;"></li>
                                    <li>
                                        <a class="dropdown-item rounded-3 mx-2 my-1" href="/dashboard" style="transition: all 0.3s ease;" onmouseover="this.style.background='linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)'; this.style.color='white'" onmouseout="this.style.background='transparent'; this.style.color='inherit'">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" style="margin: 0.5rem 0;"></li>
                                <li>
                                <a class="dropdown-item text-danger rounded-3 mx-2 my-1" @onclick="LogOut" style="transition: all 0.3s ease; font-weight: 600;" onmouseover="this.style.background='linear-gradient(135deg, #f5576c 0%, #f093fb 100%)'; this.style.color='white'" onmouseout="this.style.background='transparent'; this.style.color='#dc3545'">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-3 py-2 rounded-3 mx-1" href="/login" style="transition: all 0.3s ease; background: rgba(255,255,255,0.15);" onmouseover="this.style.background='rgba(255,255,255,0.3)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='translateY(0)'">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-4 py-2 rounded-pill mx-1" href="/users-registration" style="transition: all 0.3s ease; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); box-shadow: 0 4px 15px rgba(245, 87, 108, 0.4);" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 25px rgba(245, 87, 108, 0.6)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(245, 87, 108, 0.4)'">
                                <i class="fas fa-user-plus me-2"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

@code {
    private bool isAuthenticated = false;
    private string userName = "";
    private string userEmail = "";
    private string userRole = "";
    private AuthenticationState? authState;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to authentication state changes
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        
        // Subscribe to location changes
        Nav.LocationChanged += OnLocationChanged;
        
        // Load initial state
        await LoadUserInfo();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserInfo();
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Refresh user info when location changes (e.g., after login/logout redirect)
        _ = Task.Run(async () =>
        {
            await LoadUserInfo();
            await InvokeAsync(() =>
            {
                StateHasChanged();
            });
        });
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        try
        {
            authState = await authStateTask;
            await LoadUserInfo();
            await InvokeAsync(() =>
            {
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling authentication state change: {ex.Message}");
        }
    }

    private async Task LoadUserInfo()
    {
        try
        {
            var authToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            isAuthenticated = !string.IsNullOrEmpty(authToken);

            if (isAuthenticated)
            {
                userName = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userName") ?? "User";
                userEmail = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userEmail") ?? "";
                userRole = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userRole") ?? "Customer";
            }
            else
            {
                // Clear user info when not authenticated
                userName = "";
                userEmail = "";
                userRole = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user info: {ex.Message}");
        }
    }

    private async Task LogOut()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "userId");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "userEmail");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "userName");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "userRole");

        // Clear local state immediately
        isAuthenticated = false;
        userName = "";
        userEmail = "";
        userRole = "";

        // Notify authentication state changed
        if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
        {
            customProvider.NotifyUserLogout();
        }

        StateHasChanged();

        // Redirect to home page
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        // Unsubscribe from authentication state changes
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        
        // Unsubscribe from location changes
        Nav.LocationChanged -= OnLocationChanged;
    }
}

