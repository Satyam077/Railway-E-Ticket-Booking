@page "/dashboard"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

<PageTitle>Admin Dashboard - Railway Ticket Booking</PageTitle>

<div class="user-management-container min-vh-100">
    <div class="container-fluid py-4">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h1 class="page-title">
                    <i class="fas fa-tachometer-alt me-2"></i>
                    Admin Dashboard
                </h1>
                <div class="d-flex gap-2">
                    <button class="add-user-btn" onclick="window.location.href='/registration'">
                        <i class="fas fa-users me-2"></i>
                        Manage Users
                    </button>
                </div>
            </div>
        </div>

        <!-- Welcome Banner -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-5 text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h2 class="display-5 fw-bold mb-3" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
                                    Welcome to Railway Ticket Booking
                                </h2>
                                <p class="lead mb-3 opacity-90">Your one-stop solution for railway ticket reservations</p>
                                <p class="mb-0 opacity-75">Book your train tickets easily and securely with our advanced booking system.</p>
                            </div>
                            <div class="col-md-4 text-center">
                                <i class="fas fa-train fa-5x opacity-75" style="filter: drop-shadow(0 4px 8px rgba(0,0,0,0.2));"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Cards -->
        <div class="row g-4 mb-4">
            <!-- User Management -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h5 class="user-name">User Management</h5>
                    <p class="text-white opacity-75 mb-4">Register new users and manage existing accounts.</p>
                    <a href="/users" class="add-user-btn text-decoration-none d-inline-flex align-items-center">
                        <i class="fas fa-arrow-right me-2"></i>
                        Manage Users
                    </a>
                </div>
            </div>

            <!-- Train Management -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-train fa-2x"></i>
                    </div>
                    <h5 class="user-name">Train Management</h5>
                    <p class="text-white opacity-75 mb-4">Manage trains, schedules, and routes efficiently.</p>
                    <a href="/trains" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-arrow-right me-2"></i>
                        View Trains
                    </a>
                </div>
            </div>

            <!-- Stations Management -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-map-marker-alt fa-2x"></i>
                    </div>
                    <h5 class="user-name">Stations Management</h5>
                    <p class="text-white opacity-75 mb-4">View, create, edit, and delete station operations.</p>
                    <a href="/stations" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Stations
                    </a>
                </div>
            </div>

            <!-- Routes Management -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #ffd89b, #19547b);">
                        <i class="fas fa-route fa-2x"></i>
                    </div>
                    <h5 class="user-name">Routes Management</h5>
                    <p class="text-white opacity-75 mb-4">View routes and system analytics.</p>
                    <a href="/routes" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #ffd89b, #19547b);">
                        <i class="fas fa-arrow-right me-2"></i>
                        View Routes
                    </a>
                </div>
            </div>
        </div>

        <!-- Additional Management Cards -->
        <div class="row g-4 mb-4">
            <!-- Train Schedules -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                        <i class="fas fa-calendar-alt fa-2x"></i>
                    </div>
                    <h5 class="user-name">Train Schedules</h5>
                    <p class="text-white opacity-75 mb-4">Manage train schedules and timings.</p>
                    <a href="/train-schedules" class="add-user-btn text-decoration-none d-inline-flex align-items-center">
                        <i class="fas fa-arrow-right me-2"></i>
                        Schedules
                    </a>
                </div>
            </div>

            <!-- Search Trains -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-search fa-2x"></i>
                    </div>
                    <h5 class="user-name">Search Trains</h5>
                    <p class="text-white opacity-75 mb-4">Search and view available trains.</p>
                    <a href="/" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Search
                    </a>
                </div>
            </div>

            <!-- Booking List -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-ticket-alt fa-2x"></i>
                    </div>
                    <h5 class="user-name">All Bookings</h5>
                    <p class="text-white opacity-75 mb-4">View all booking records and analytics.</p>
                    <a href="/admin/all-bookings" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Bookings
                    </a>
                </div>
            </div>

            <!-- Reports -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-chart-bar fa-2x"></i>
                    </div>
                    <h5 class="user-name">Reports & Analytics</h5>
                    <p class="text-white opacity-75 mb-4">View system reports and statistics.</p>
                    <a href="/reports" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Reports
                    </a>
                </div>
            </div>
        </div>

        <!-- Users Management -->
        <div class="row g-4 mb-4">
            <!-- Users List -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                        <i class="fas fa-calendar-alt fa-2x"></i>
                    </div>
                    <h5 class="user-name">Users List</h5>
                    <p class="text-white opacity-75 mb-4">View Users List.</p>
                    <a href="/users-list" class="add-user-btn text-decoration-none d-inline-flex align-items-center">
                        <i class="fas fa-arrow-right me-2"></i>
                        Users List
                    </a>
                </div>
            </div>

            <!-- Search Trains -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-search fa-2x"></i>
                    </div>
                    <h5 class="user-name">Home</h5>
                    <p class="text-white opacity-75 mb-4">Search and view Home.</p>
                    <a href="/home" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Home
                    </a>
                </div>
            </div>

            <!-- Booking List -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-ticket-alt fa-2x"></i>
                    </div>
                    <h5 class="user-name">All Bookings</h5>
                    <p class="text-white opacity-75 mb-4">View all booking records and analytics.</p>
                    <a href="/admin/all-bookings" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Bookings
                    </a>
                </div>
            </div>

            <!-- Reports -->
            <div class="col-md-6 col-lg-3">
                <div class="user-card h-100 text-center">
                    <div class="user-avatar mx-auto mb-3" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-chart-bar fa-2x"></i>
                    </div>
                    <h5 class="user-name">Reports & Analytics</h5>
                    <p class="text-white opacity-75 mb-4">View system reports and statistics.</p>
                    <a href="/reports" class="add-user-btn text-decoration-none d-inline-flex align-items-center" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                        <i class="fas fa-arrow-right me-2"></i>
                        Reports
                    </a>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats-container">
            <div class="stat-item">
                <span class="stat-value"><i class="fas fa-users"></i> 500+</span>
                <span class="stat-label">Total Users</span>
            </div>
            <div class="stat-item">
                <span class="stat-value"><i class="fas fa-train"></i> 200+</span>
                <span class="stat-label">Active Trains</span>
            </div>
            <div class="stat-item">
                <span class="stat-value"><i class="fas fa-ticket-alt"></i> 10K+</span>
                <span class="stat-label">Bookings</span>
            </div>
            <div class="stat-item">
                <span class="stat-value"><i class="fas fa-map-marked-alt"></i> 150+</span>
                <span class="stat-label">Stations</span>
            </div>
        </div>
    </div>
</div>
