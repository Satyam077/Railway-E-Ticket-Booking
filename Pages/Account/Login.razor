@page "/login"
@using RailwayTicketBooking.Application.Account.Commands
@using MediatR
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using RailwayTicketBooking.Application.Commands
@using RailwayTicketBooking.Infrastructure.Services
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="user-management-container min-vh-100">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(15px);">
                    <!-- Card Header with Gradient -->
                    <div class="card-header text-white text-center py-4 border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="fas fa-sign-in-alt fa-3x mb-3" style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
                        <h3 class="mb-0 fw-bold" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2);">Welcome Back!</h3>
                        <p class="mb-0 small opacity-75">Sign in to continue your journey</p>
                    </div>
                    
                    <div class="card-body p-4 p-md-5">
                        <EditForm Model="@loginCommand" OnValidSubmit="@HandleLogin">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger rounded-3" />

                            <div class="mb-4">
                                <label class="form-label-custom fw-bold">
                                    <i class="fas fa-envelope text-primary me-2"></i>Email Address
                                </label>
                                <InputText class="form-control form-control-custom form-control-lg" @bind-Value="loginCommand.Email" type="email" placeholder="Enter your email" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom fw-bold">
                                    <i class="fas fa-lock text-primary me-2"></i>Password
                                </label>
                                <InputText class="form-control form-control-custom form-control-lg" @bind-Value="loginCommand.Password" type="password" placeholder="Enter your password" />
                            </div>

                            <div class="mb-4 d-flex justify-content-between align-items-center">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" id="rememberMe" @bind-Value="rememberMe" />
                                    <label class="form-check-label fw-semibold" for="rememberMe">Remember me</label>
                                </div>
                                <a href="/forgot-password" class="text-decoration-none fw-semibold" style="background: linear-gradient(135deg, #667eea, #764ba2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Forgot Password?</a>
                            </div>

                            <button type="submit" class="submit-btn w-100 py-3 mb-3" disabled="@isLoggingIn">
                                @if (isLoggingIn)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <text>Signing in...</text>
                                }
                                else
                                {
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    <text>Sign In</text>
                                }
                            </button>
                        </EditForm>

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert-custom @(isSuccess ? "alert-success-custom" : "alert-danger-custom") mb-3">
                                <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                                @message
                            </div>
                        }

                        <div class="text-center pt-3 border-top">
                            <p class="mb-0 text-muted">
                                Don't have an account? 
                                <a href="/users-registration" class="text-decoration-none fw-bold" style="background: linear-gradient(135deg, #f093fb, #f5576c); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Register Now</a>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Additional Info Card -->
                <div class="card border-0 shadow-lg rounded-4 mt-4" style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px);">
                    <div class="card-body text-center text-white p-4">
                        <i class="fas fa-shield-alt fa-2x mb-3" style="color: #f093fb;"></i>
                        <h6 class="fw-bold mb-2">Secure Login</h6>
                        <p class="small mb-0 opacity-75">Your data is protected with industry-standard encryption</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginCommand loginCommand = new LoginCommand();
    private string message = string.Empty;
    private bool isSuccess = false;
    private bool isLoggingIn = false;
    private bool rememberMe = false;

    private async Task HandleLogin()
    {
        isLoggingIn = true;
        message = string.Empty;

        try
        {
            var result = await Mediator.Send(loginCommand);

            if (result.IsSuccess && !string.IsNullOrEmpty(result.Token))
            {
                // Store token in localStorage
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userId", result.UserId);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userEmail", result.Email);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userName", result.FullName);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userRole", result.Role);

                // Notify authentication state changed
                if (AuthenticationStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    customProvider.NotifyUserAuthentication(result.Token);
                }

                message = result.Message;
                isSuccess = true;

                // Wait for authentication state to propagate
                await Task.Delay(500);
                StateHasChanged();

                // Check if there's a pending booking
                var pendingBooking = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "pendingBooking");
                
                await Task.Delay(500);
                
                // Get returnUrl from query string
                var uri = new Uri(NavigationManager.Uri);
                var returnUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var returnUrlValue) 
                    ? returnUrlValue.ToString() 
                    : null;

                if (!string.IsNullOrEmpty(pendingBooking) || returnUrl == "/booking")
                {
                    NavigationManager.NavigateTo("/booking");
                }
                else
                {
                    // Redirect based on user role
                    var userRole = result.Role;
                    if (userRole == "Admin" || userRole == "SuperAdmin")
                    {
                        NavigationManager.NavigateTo("/dashboard");
                    }
                    else
                    {
                        // Customer or other roles go to user dashboard
                        NavigationManager.NavigateTo("/user-dashboard");
                    }
                }
            }
            else
            {
                message = result.Message ?? "Login failed. Please check your credentials.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            message = $"Error during login: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isLoggingIn = false;
        }
    }
}
