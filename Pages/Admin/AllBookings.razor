@page "/admin/all-bookings"
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Railway_Ticket_Booking.Application.Bookings.Queries
@using Railway_Ticket_Booking.Domain.Entities
@using Railway_Ticket_Booking.Domain.Enums
@using System.Linq
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject IMediator Mediator
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-list-alt me-2 text-primary"></i>All Bookings
        </h2>
        <button class="btn btn-outline-primary" @onclick="RefreshBookings">
            <i class="fas fa-sync-alt me-2"></i>Refresh
        </button>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted">Filter by Status</label>
                    <select class="form-select" @bind="selectedStatus" @bind:after="FilterBookings">
                        <option value="">All Bookings</option>
                        <option value="@BookingStatus.Confirmed">Confirmed</option>
                        <option value="@BookingStatus.Pending">Pending</option>
                        <option value="@BookingStatus.Cancelled">Cancelled</option>
                        <option value="@BookingStatus.WaitListed">Wait Listed</option>
                        <option value="@BookingStatus.Failed">Failed</option>
                        <option value="@BookingStatus.Refunded">Refunded</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Filter by Active Status</label>
                    <select class="form-select" @bind="selectedActiveStatus" @bind:after="FilterBookings">
                        <option value="">All</option>
                        <option value="true">Active Only</option>
                        <option value="false">Inactive Only</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Search by PNR</label>
                    <input type="text" class="form-control" placeholder="Enter PNR number" 
                           @bind="searchPnr" @bind:after="FilterBookings" />
                </div>
            </div>
            @if (filteredBookings != null && allBookings != null && filteredBookings.Count != allBookings.Count)
            {
                <div class="mt-3">
                    <small class="text-muted">
                        Showing @filteredBookings.Count of @allBookings.Count bookings
                    </small>
                </div>
            }
        </div>
    </div>

    @if (!loaded)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading bookings...</p>
        </div>
    }
    else if (filteredBookings == null || !filteredBookings.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No Bookings Found</h4>
                <p class="text-muted">
                    @if (allBookings != null && allBookings.Any())
                    {
                        <text>No bookings match your filter criteria.</text>
                    }
                    else
                    {
                        <text>No bookings have been made yet.</text>
                    }
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Total Bookings</h6>
                        <h3 class="mb-0">@allBookings.Count</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h6 class="card-title">Confirmed</h6>
                        <h3 class="mb-0">@allBookings.Count(b => b.Status == BookingStatus.Confirmed)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <h6 class="card-title">Pending</h6>
                        <h3 class="mb-0">@allBookings.Count(b => b.Status == BookingStatus.Pending)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body">
                        <h6 class="card-title">Cancelled</h6>
                        <h3 class="mb-0">@allBookings.Count(b => b.Status == BookingStatus.Cancelled)</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bookings Table -->
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>PNR</th>
                                <th>User ID</th>
                                <th>Train ID</th>
                                <th>Source</th>
                                <th>Destination</th>
                                <th>Journey Date</th>
                                <th>Passengers</th>
                                <th>Status</th>
                                <th>Amount</th>
                                <th>Booking Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in filteredBookings)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-primary">@booking.PNR</strong>
                                    </td>
                                    <td>
                                        <small>@booking.UserId</small>
                                    </td>
                                    <td>
                                        <small>@booking.TrainId</small>
                                    </td>
                                    <td>
                                        <small>@booking.SourceStationId</small>
                                    </td>
                                    <td>
                                        <small>@booking.DestinationStationId</small>
                                    </td>
                                    <td>
                                        <small>@booking.JourneyDate.ToString("dd MMM, yyyy")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@booking.PassengerCount</span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(booking.Status)">
                                            @booking.Status.ToString()
                                        </span>
                                    </td>
                                    <td>
                                        <strong>₹@booking.FinalAmount.ToString("N2")</strong>
                                    </td>
                                    <td>
                                        <small>@booking.BookingDate.ToString("dd MMM, yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" 
                                        @onclick="() => ViewBookingDetails(booking.Id)"
                                        title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination or Summary -->
        <div class="mt-3">
            <small class="text-muted">
                Total Amount: <strong>₹@allBookings.Sum(b => b.FinalAmount).ToString("N2")</strong> |
                Active Bookings: <strong>@allBookings.Count(b => b.IsActive)</strong>
            </small>
        </div>
    }
</div>

@code {
    private List<Booking> filteredBookings = new List<Booking>();
    private List<Booking> allBookings = new List<Booking>();
    private bool loaded = false;
    private string selectedStatus = "";
    private string selectedActiveStatus = "";
    private string searchPnr = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        loaded = false;
        try
        {
            var query = new GetAllBookingsQuery();
            allBookings = await Mediator.Send(query);
            FilterBookings();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading bookings: {ex.Message}");
            allBookings = new List<Booking>();
            filteredBookings = new List<Booking>();
        }
        finally
        {
            loaded = true;
            StateHasChanged();
        }
    }

    private void FilterBookings()
    {
        if (allBookings == null)
        {
            filteredBookings = new List<Booking>();
            return;
        }

        filteredBookings = allBookings.ToList();

        // Filter by status
        if (!string.IsNullOrEmpty(selectedStatus) && Enum.TryParse<BookingStatus>(selectedStatus, out var status))
        {
            filteredBookings = filteredBookings.Where(b => b.Status == status).ToList();
        }

        // Filter by active status
        if (!string.IsNullOrEmpty(selectedActiveStatus) && bool.TryParse(selectedActiveStatus, out var isActive))
        {
            filteredBookings = filteredBookings.Where(b => b.IsActive == isActive).ToList();
        }

        // Filter by PNR
        if (!string.IsNullOrEmpty(searchPnr))
        {
            filteredBookings = filteredBookings.Where(b => 
                b.PNR.Contains(searchPnr, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        filteredBookings = filteredBookings.ToList();
        StateHasChanged();
    }

    private async Task RefreshBookings()
    {
        await LoadBookings();
    }

    private void ViewBookingDetails(string bookingId)
    {
        NavigationManager.NavigateTo($"/booking-confirmation/{bookingId}");
    }

    private string GetStatusBadgeClass(BookingStatus status)
    {
        return status switch
        {
            BookingStatus.Confirmed => "bg-success",
            BookingStatus.Pending => "bg-warning text-dark",
            BookingStatus.Cancelled => "bg-danger",
            BookingStatus.WaitListed => "bg-info",
            BookingStatus.Failed => "bg-dark",
            BookingStatus.Refunded => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}

