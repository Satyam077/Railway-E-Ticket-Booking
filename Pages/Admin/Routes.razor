@page "/routes"
@using MediatR
@using RailwayTicketBooking.Application.Queries
@using RailwayTicketBooking.Application.Routes.Commands
@using RailwayTicketBooking.Application.Routes.Queries
@using RailwayTicketBooking.Domain.Entities
@inject IMediator Mediator
@inject IJSRuntime JSRuntime

<!-- Main Container with vibrant gradient background -->
<div class="user-management-container min-vh-100">
    
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="user-avatar" style="width: 80px; height: 80px;">
                    <i class="fas fa-route fa-2x"></i>
                </div>
                <div>
                    <h1 class="page-title mb-0">Route Management</h1>
                    <p class="text-white opacity-75 mb-0 small">Manage all routes in the system</p>
                </div>
            </div>
            <button class="add-user-btn" @onclick="OpenAddRouteModal">
                <i class="fas fa-plus-circle"></i>
                Add Route
            </button>
        </div>
    </div>

    <!-- Statistics -->
    @if (routes != null && routes.Any())
    {
        <div class="stats-container mb-4">
            <div class="stat-item">
                <span class="stat-value">@routes.Count</span>
                <span class="stat-label"><i class="fas fa-route me-2"></i>Total Routes</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@routes.Count(r => r.IsActive)</span>
                <span class="stat-label"><i class="fas fa-check-circle me-2"></i>Active Routes</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@routes.Sum(r => r.TotalDistance).ToString("F0")</span>
                <span class="stat-label"><i class="fas fa-map-marked-alt me-2"></i>Total Distance (KM)</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@routes.Sum(r => r.TrainIds?.Count ?? 0)</span>
                <span class="stat-label"><i class="fas fa-train me-2"></i>Total Trains</span>
            </div>
        </div>
    }

    <!-- Routes List -->
    <div class="container py-4">
        @if (routes == null)
        {
            <div class="loading-container">
                <div class="spinner-custom mb-3"></div>
                <h5 class="text-white">Loading routes...</h5>
            </div>
        }
        else if (!routes.Any())
        {
            <div class="user-card text-center py-5">
                <i class="fas fa-route fa-5x mb-4" style="color: rgba(255,255,255,0.3);"></i>
                <h4 class="user-name mb-3">No Routes Found</h4>
                <p class="text-white opacity-75 mb-4">Create your first route to get started.</p>
                <button class="add-user-btn" @onclick="OpenAddRouteModal">
                    <i class="fas fa-plus-circle"></i>
                    Add First Route
                </button>
            </div>
        }
        else
        {
            <div class="users-grid">
                @foreach (var route in routes)
                {
                    <div class="user-card @(isEditing && selectedRouteId == route.Id ? "border-warning" : "")" style="@(isEditing && selectedRouteId == route.Id ? "border: 3px solid #ffc107 !important;" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="flex-grow-1">
                                <h5 class="user-name mb-2">@GetStationName(route.SourceStationId)</h5>
                                <div class="mb-2">
                                    <i class="fas fa-arrow-down text-white opacity-75 me-2"></i>
                                    <span class="text-white opacity-75">to</span>
                                </div>
                                <h5 class="user-name mb-1">@GetStationName(route.DestinationStationId)</h5>
                            </div>
                            <div>
                                <span class="meta-badge @(route.IsActive ? "status-active" : "status-inactive")">
                                    @route.StatusText
                                </span>
                            </div>
                        </div>

                        <div class="user-meta mb-3">
                            <span class="meta-badge">
                                <i class="fas fa-map-marked-alt me-1"></i>@route.TotalDistance.ToString("F1") KM
                            </span>
                            <span class="meta-badge">
                                <i class="fas fa-train me-1"></i>@(route.TrainIds?.Count ?? 0) Trains
                            </span>
                            <span class="meta-badge">
                                <i class="fas fa-map-pin me-1"></i>@route.StationCount Stations
                            </span>
                            <span class="meta-badge">
                                <i class="far fa-calendar me-1"></i>@route.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                        </div>

                        @if (route.TrainIds?.Any() == true)
                        {
                            <div class="mb-3">
                                <small class="text-white opacity-75 d-block mb-2">Trains:</small>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var trainId in route.TrainIds.Take(3))
                                    {
                                        var train = trains.FirstOrDefault(t => t.Id == trainId);
                                        if (train != null)
                                        {
                                            <span class="meta-badge" style="font-size: 0.7rem;">
                                                @train.TrainNumber
                                            </span>
                                        }
                                    }
                                    @if (route.TrainIds.Count > 3)
                                    {
                                        <span class="meta-badge" style="font-size: 0.7rem;">
                                            +@(route.TrainIds.Count - 3) more
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        @if (route.Stations?.Any(s => s.IsMajorStation) == true)
                        {
                            <div class="mb-3">
                                <small class="text-white opacity-75 d-block mb-2">
                                    Major Stations: <strong>@route.Stations.Count(s => s.IsMajorStation)</strong>
                                </small>
                            </div>
                        }

                        <div class="user-actions">
                            <button class="action-btn action-btn-edit" @onclick="() => EditRoute(route)" disabled="@(isCreating || isUpdating || isDeleting)">
                                <i class="fas fa-edit me-1"></i>Edit
                            </button>
                            <button class="action-btn @(route.IsActive ? "action-btn-delete" : "action-btn-edit")" 
                                    @onclick="() => ToggleRouteStatus(route)" 
                                    disabled="@(isCreating || isUpdating || isDeleting)">
                                <i class="fas @(route.IsActive ? "fa-pause" : "fa-play") me-1"></i>
                                @(route.IsActive ? "Deactivate" : "Activate")
                            </button>
                            <button class="action-btn action-btn-delete" 
                                    @onclick="() => DeleteRoute(route)" 
                                    disabled="@(isCreating || isUpdating || isDeleting)">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Add/Edit Route Modal -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content-custom" @onclick:stopPropagation="true" style="max-width: 900px;">
            <div class="modal-header-custom">
                <h3 class="modal-title-custom">
                    <i class="fas fa-route me-2"></i>
                    @(isEditing ? "Update Route" : "Create New Route")
                </h3>
                <button class="close-btn" @onclick="CloseModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <EditForm Model="@(isEditing ? updateRouteCommand : (object)newRouteCommand)" OnValidSubmit="@(isEditing ? UpdateRoute : CreateRoute)">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger-custom" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Source Station</label>
                        @if (isEditing)
                        {
                            <InputSelect class="form-control form-control-custom" @bind-Value="updateRouteCommand.SourceStationId">
                                <option value="">Select Source Station</option>
                                @foreach (var station in stations)
                                {
                                    <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <InputSelect class="form-control form-control-custom" @bind-Value="newRouteCommand.SourceStationId">
                                <option value="">Select Source Station</option>
                                @foreach (var station in stations)
                                {
                                    <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                }
                            </InputSelect>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Destination Station</label>
                        @if (isEditing)
                        {
                            <InputSelect class="form-control form-control-custom" @bind-Value="updateRouteCommand.DestinationStationId">
                                <option value="">Select Destination Station</option>
                                @foreach (var station in stations)
                                {
                                    <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <InputSelect class="form-control form-control-custom" @bind-Value="newRouteCommand.DestinationStationId">
                                <option value="">Select Destination Station</option>
                                @foreach (var station in stations)
                                {
                                    <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                }
                            </InputSelect>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Total Distance (KM)</label>
                        @if (isEditing)
                        {
                            <InputNumber class="form-control form-control-custom" @bind-Value="updateRouteCommand.TotalDistance" min="0" step="0.1" />
                        }
                        else
                        {
                            <InputNumber class="form-control form-control-custom" @bind-Value="newRouteCommand.TotalDistance" min="0" step="0.1" />
                        }
                    </div>

                    @if (isEditing)
                    {
                        <div class="col-md-6">
                            <label class="form-label-custom">Status</label>
                            <div class="form-check form-switch p-3 rounded-3" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.2);">
                                <InputCheckbox class="form-check-input" @bind-Value="updateRouteCommand.IsActive" />
                                <label class="form-check-label form-label-custom">
                                    @(updateRouteCommand.IsActive ? "Active" : "Inactive")
                                </label>
                            </div>
                        </div>
                    }

                    <div class="col-12">
                        <label class="form-label-custom">
                            <i class="fas fa-train me-2"></i>Trains
                        </label>
                        <div class="train-selection-container" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.2); border-radius: 10px; padding: 1rem;">
                            @{
                                var currentTrainIds = isEditing ? updateRouteCommand.TrainIds : newRouteCommand.TrainIds;
                            }
                            
                            @if (currentTrainIds.Any())
                            {
                                <div class="selected-trains mb-3">
                                    <h6 class="form-label-custom mb-2">Selected Trains:</h6>
                                    <div class="selected-trains-list">
                                        @foreach (var trainId in currentTrainIds)
                                        {
                                            var train = trains.FirstOrDefault(t => t.Id == trainId);
                                            if (train != null)
                                            {
                                                <span class="meta-badge status-active" style="display: inline-flex; align-items: center; padding: 0.5rem 0.75rem;">
                                                    @train.TrainNumber - @train.Name
                                                    <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.7rem;" 
                                                            @onclick="() => RemoveTrainFromRoute(trainId)"></button>
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            
                            <div class="input-group">
                                <select class="form-control form-control-custom" @onchange="OnTrainSelected" value="">
                                    <option value="">Select a train to add...</option>
                                    @foreach (var train in trains.Where(t => !currentTrainIds.Contains(t.Id)))
                                    {
                                        <option value="@train.Id">@train.TrainNumber - @train.Name (@train.TrainType)</option>
                                    }
                                </select>
                                <button class="action-btn action-btn-delete" type="button" @onclick="ClearAllTrains" style="padding: 0.5rem 1rem;">
                                    Clear All
                                </button>
                            </div>
                            
                            <small class="text-white opacity-75 d-block mt-2" style="font-size: 0.85rem;">
                                Select multiple trains that will operate on this route.
                            </small>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label-custom">
                            <i class="fas fa-map-pin me-2"></i>Route Stations
                        </label>
                        @{
                            var currentStations = isEditing ? updateRouteCommand.Stations : newRouteCommand.Stations;
                        }
                        @for (int i = 0; i < currentStations.Count; i++)
                        {
                            var index = i;
                            <div class="user-card mb-3" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.2);">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Station</label>
                                        <InputSelect class="form-control form-control-custom" @bind-Value="currentStations[index].StationId">
                                            <option value="">Select Station</option>
                                            @foreach (var station in stations)
                                            {
                                                <option value="@station.Id">@station.StationName</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Order</label>
                                        <InputNumber class="form-control form-control-custom" @bind-Value="currentStations[index].StationOrder" min="1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Distance (KM)</label>
                                        <InputNumber class="form-control form-control-custom" @bind-Value="currentStations[index].DistanceFromSource" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Arrival</label>
                                        <input type="time" class="form-control form-control-custom"
                                               value='@currentStations[index].ArrivalTime.ToString(@"hh\:mm")'
                                               @onchange='e => currentStations[index].ArrivalTime = TimeSpan.Parse(e.Value?.ToString() ?? "00:00")' />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Departure</label>
                                        <input type="time" class="form-control form-control-custom"
                                               value='@currentStations[index].DepartureTime.ToString(@"hh\:mm")'
                                               @onchange='e => currentStations[index].DepartureTime = TimeSpan.Parse(e.Value?.ToString() ?? "00:00")' />
                                    </div>
                                    <div class="col-md-12">
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label class="form-label-custom" style="font-size: 0.85rem;">Halt Duration (min)</label>
                                                <InputNumber @bind-Value="currentStations[index].HaltMinutes"
                                                             class="form-control form-control-custom"
                                                             min="0" max="120" />
                                            </div>
                                            <div class="col-md-3 d-flex align-items-end">
                                                <div class="form-check form-switch p-3 rounded-3" style="background: rgba(102, 126, 234, 0.05);">
                                                    <InputCheckbox class="form-check-input" @bind-Value="currentStations[index].IsMajorStation" />
                                                    <label class="form-check-label form-label-custom" style="font-size: 0.85rem;">Major Station</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6 d-flex align-items-end">
                                                <button type="button" class="action-btn action-btn-delete w-100" @onclick="() => RemoveStation(index)" style="padding: 0.5rem;">
                                                    <i class="fas fa-trash me-1"></i>Remove
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <button type="button" class="add-user-btn btn-sm" @onclick="AddStation" style="padding: 0.5rem 1.5rem;">
                            <i class="fas fa-plus-circle"></i>Add Station
                        </button>
                    </div>

                    <div class="col-12 d-flex gap-2 justify-content-end mt-4">
                        <button type="button" class="cancel-btn" @onclick="CloseModal">
                            Cancel
                        </button>
                        <button type="submit" class="submit-btn" disabled="@(isCreating || isUpdating)">
                            @if (isEditing)
                            {
                                @if (isUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <text>Updating...</text>
                                }
                                else
                                {
                                    <i class="fas fa-save me-2"></i>
                                    <text>Update Route</text>
                                }
                            }
                            else
                            {
                                @if (isCreating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <text>Creating...</text>
                                }
                                else
                                {
                                    <i class="fas fa-plus-circle me-2"></i>
                                    <text>Create Route</text>
                                }
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private CreateRouteCommand newRouteCommand = new CreateRouteCommand();
    private UpdateRouteCommand updateRouteCommand = new UpdateRouteCommand();
    private List<RailwayTicketBooking.Domain.Entities.Route> routes = new List<RailwayTicketBooking.Domain.Entities.Route>();
    private List<Station> stations = new List<Station>();
    private List<Train> trains = new List<Train>();
    private bool isCreating = false;
    private bool isUpdating = false;
    private bool isDeleting = false;
    private bool isEditing = false;
    private bool showModal = false;
    private string selectedRouteId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        trains = await Mediator.Send(new GetAllTrainsQuery());

        if (!newRouteCommand.Stations.Any())
        {
            newRouteCommand.Stations.Add(new RouteStation { StationOrder = 1 });
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var loadRoutesTask = LoadRoutes();
            var loadStationsTask = LoadStations();

            await Task.WhenAll(loadRoutesTask, loadStationsTask);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error loading data: {ex.Message}");
        }
    }

    private async Task LoadRoutes()
    {
        routes = await Mediator.Send(new GetAllRoutesQuery());
    }

    private async Task LoadStations()
    {
        stations = await Mediator.Send(new GetAllStationsQuery());
    }

    private void OpenAddRouteModal()
    {
        isEditing = false;
        showModal = true;
        newRouteCommand = new CreateRouteCommand();
        newRouteCommand.Stations.Add(new RouteStation { StationOrder = 1 });
        updateRouteCommand = new UpdateRouteCommand();
        selectedRouteId = string.Empty;
    }

    private void CloseModal()
    {
        showModal = false;
        if (!isEditing)
        {
            CancelEdit();
        }
    }

    private async Task CreateRoute()
    {
        isCreating = true;

        try
        {
            if (string.IsNullOrWhiteSpace(newRouteCommand.SourceStationId))
            {
                await JSRuntime.InvokeVoidAsync("showError", "Please select a source station.");
                isCreating = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(newRouteCommand.DestinationStationId))
            {
                await JSRuntime.InvokeVoidAsync("showError", "Please select a destination station.");
                isCreating = false;
                return;
            }

            if (!newRouteCommand.TrainIds.Any())
            {
                await JSRuntime.InvokeVoidAsync("showError", "Please select at least one train for this route.");
                isCreating = false;
                return;
            }

            var validStations = newRouteCommand.Stations
                .Where(s => !string.IsNullOrWhiteSpace(s.StationId))
                .OrderBy(s => s.StationOrder)
                .ToList();

            newRouteCommand.Stations = validStations;

            var routeId = await Mediator.Send(newRouteCommand);
            await JSRuntime.InvokeVoidAsync("showSuccess", "Route created successfully!");

            newRouteCommand = new CreateRouteCommand();
            newRouteCommand.Stations.Add(new RouteStation { StationOrder = 1 });
            showModal = false;

            await LoadRoutes();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error creating route: {ex.Message}");
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task UpdateRoute()
    {
        isUpdating = true;

        try
        {
            var validStations = updateRouteCommand.Stations
                .Where(s => !string.IsNullOrWhiteSpace(s.StationId))
                .OrderBy(s => s.StationOrder)
                .ToList();

            updateRouteCommand.Stations = validStations;

            var result = await Mediator.Send(updateRouteCommand);

            if (result)
            {
                await JSRuntime.InvokeVoidAsync("showSuccess", "Route updated successfully!");
                CancelEdit();
                showModal = false;
                await LoadRoutes();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showError", "Failed to update route. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error updating route: {ex.Message}");
        }
        finally
        {
            isUpdating = false;
        }
    }

    private void EditRoute(Route route)
    {
        isEditing = true;
        selectedRouteId = route.Id;
        showModal = true;

        updateRouteCommand = new UpdateRouteCommand
        {
            Id = route.Id,
            SourceStationId = route.SourceStationId,
            DestinationStationId = route.DestinationStationId,
            TotalDistance = route.TotalDistance,
            IsActive = route.IsActive,
            TrainIds = new List<string>(route.TrainIds ?? new List<string>()),
            Stations = route.Stations?.Select(s => new RouteStation
            {
                StationId = s.StationId,
                StationOrder = s.StationOrder,
                DistanceFromSource = s.DistanceFromSource,
                ArrivalTime = s.ArrivalTime,
                DepartureTime = s.DepartureTime,
                HaltDuration = s.HaltDuration,
                IsMajorStation = s.IsMajorStation
            }).ToList() ?? new List<RouteStation>()
        };

        if (!updateRouteCommand.Stations.Any())
        {
            updateRouteCommand.Stations.Add(new RouteStation { StationOrder = 1 });
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        selectedRouteId = string.Empty;
        updateRouteCommand = new UpdateRouteCommand();
    }

    private async Task ToggleRouteStatus(Route route)
    {
        try
        {
            var updateCommand = new UpdateRouteCommand
            {
                Id = route.Id,
                SourceStationId = route.SourceStationId,
                DestinationStationId = route.DestinationStationId,
                TotalDistance = route.TotalDistance,
                IsActive = !route.IsActive,
                TrainIds = route.TrainIds ?? new List<string>(),
                Stations = route.Stations ?? new List<RouteStation>()
            };

            var result = await Mediator.Send(updateCommand);

            if (result)
            {
                await JSRuntime.InvokeVoidAsync("showSuccess", $"Route {(route.IsActive ? "deactivated" : "activated")} successfully!");
                await LoadRoutes();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showError", "Failed to update route status.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error updating route status: {ex.Message}");
        }
    }

    private async Task DeleteRoute(Route route)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete route '{route.DisplayName}'?\n\nThis action cannot be undone.");
        
        if (!confirmed)
            return;

        isDeleting = true;
        selectedRouteId = route.Id;

        try
        {
            var result = await Mediator.Send(new DeleteRouteCommand(route.Id));

            if (result)
            {
                await JSRuntime.InvokeVoidAsync("showSuccess", $"Route '{route.DisplayName}' deleted successfully!");
                await LoadRoutes();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showError", "Failed to delete route. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error deleting route: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            selectedRouteId = string.Empty;
        }
    }

    private void AddStation()
    {
        var currentStations = isEditing ? updateRouteCommand.Stations : newRouteCommand.Stations;
        var newOrder = currentStations.Any() ? currentStations.Max(s => s.StationOrder) + 1 : 1;
        currentStations.Add(new RouteStation { StationOrder = newOrder });
    }

    private void RemoveStation(int index)
    {
        var currentStations = isEditing ? updateRouteCommand.Stations : newRouteCommand.Stations;
        if (currentStations.Count > 1)
        {
            currentStations.RemoveAt(index);
        }
        else
        {
            JSRuntime.InvokeVoidAsync("showWarning", "At least one station is required.");
        }
    }

    private string GetStationName(string stationId)
    {
        var station = stations.FirstOrDefault(s => s.Id == stationId);
        return station != null ? $"{station.StationName} ({station.StationCode})" : "Unknown Station";
    }

    private void OnTrainSelected(ChangeEventArgs e)
    {
        var selectedTrainId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedTrainId))
        {
            var currentTrainIds = isEditing ? updateRouteCommand.TrainIds : newRouteCommand.TrainIds;
            
            if (!currentTrainIds.Contains(selectedTrainId))
            {
                currentTrainIds.Add(selectedTrainId);
            }
        }
    }

    private void RemoveTrainFromRoute(string trainId)
    {
        var currentTrainIds = isEditing ? updateRouteCommand.TrainIds : newRouteCommand.TrainIds;
        currentTrainIds.Remove(trainId);
    }

    private void ClearAllTrains()
    {
        var currentTrainIds = isEditing ? updateRouteCommand.TrainIds : newRouteCommand.TrainIds;
        currentTrainIds.Clear();
    }
}
