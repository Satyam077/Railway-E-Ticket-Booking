@page "/trains"
@using MediatR
@using Railway_Ticket_Booking.Application.Commands
@using Railway_Ticket_Booking.Application.Queries
@using Railway_Ticket_Booking.Domain.Entities
@inject IMediator Mediator
@inject IJSRuntime JSRuntime

<!-- Main Container with vibrant gradient background -->
<div class="user-management-container min-vh-100">
    
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="user-avatar" style="width: 80px; height: 80px;">
                    <i class="fas fa-train fa-2x"></i>
                </div>
                <div>
                    <h1 class="page-title mb-0">Train Management</h1>
                    <p class="text-white opacity-75 mb-0 small">Manage all trains in the system</p>
                </div>
            </div>
            <button class="add-user-btn" @onclick="OpenAddTrainModal">
                <i class="fas fa-plus-circle"></i>
                Add Train
            </button>
        </div>
    </div>

    <!-- Statistics -->
    @if (trains != null && trains.Any())
    {
        <div class="stats-container mb-4">
            <div class="stat-item">
                <span class="stat-value">@trains.Count</span>
                <span class="stat-label"><i class="fas fa-train me-2"></i>Total Trains</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@trains.Count(t => t.IsActive)</span>
                <span class="stat-label"><i class="fas fa-check-circle me-2"></i>Active Trains</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@trains.Sum(t => t.TotalSeats)</span>
                <span class="stat-label"><i class="fas fa-chair me-2"></i>Total Seats</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@trains.Count(t => !t.IsActive)</span>
                <span class="stat-label"><i class="fas fa-pause-circle me-2"></i>Inactive Trains</span>
            </div>
        </div>
    }

    <!-- Trains List -->
    <div class="container py-4">
        @if (trains == null)
        {
            <div class="loading-container">
                <div class="spinner-custom mb-3"></div>
                <h5 class="text-white">Loading trains...</h5>
            </div>
        }
        else if (!trains.Any())
        {
            <div class="user-card text-center py-5">
                <i class="fas fa-train fa-5x mb-4" style="color: rgba(255,255,255,0.3);"></i>
                <h4 class="user-name mb-3">No Trains Found</h4>
                <p class="text-white opacity-75 mb-4">Create your first train to get started.</p>
                <button class="add-user-btn" @onclick="OpenAddTrainModal">
                    <i class="fas fa-plus-circle"></i>
                    Add First Train
                </button>
            </div>
        }
        else
        {
            <div class="users-grid">
                @foreach (var train in trains)
                {
                    <div class="user-card @(isEditing && selectedTrainId == train.Id ? "border-warning" : "")" style="@(isEditing && selectedTrainId == train.Id ? "border: 3px solid #ffc107 !important;" : "")">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="flex-grow-1">
                                <h5 class="user-name mb-1">@train.Name</h5>
                                <span class="meta-badge mb-2 d-inline-block">#@train.TrainNumber</span>
                                <div class="mb-2">
                                    <span class="meta-badge status-active text-uppercase small">@train.TrainType</span>
                                </div>
                            </div>
                            <div>
                                <span class="meta-badge @(train.IsActive ? "status-active" : "status-inactive")">
                                    @train.StatusText
                                </span>
                            </div>
                        </div>

                        <div class="user-meta mb-3">
                            <span class="meta-badge">
                                <i class="fas fa-chair me-1"></i>@train.TotalSeats Seats
                            </span>
                            <span class="meta-badge">
                                <i class="fas fa-layer-group me-1"></i>@(train.Classes?.Count ?? 0) Classes
                            </span>
                            <span class="meta-badge">
                                <i class="far fa-calendar me-1"></i>@train.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                        </div>

                        @if (train.Classes?.Any() == true)
                        {
                            <div class="mb-3">
                                <small class="text-white opacity-75 d-block mb-2">Classes:</small>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var trainClass in train.Classes.Take(3))
                                    {
                                        <span class="meta-badge" style="font-size: 0.7rem;">
                                            @trainClass.ClassName (@trainClass.SeatCount seats)
                                        </span>
                                    }
                                    @if (train.Classes.Count > 3)
                                    {
                                        <span class="meta-badge" style="font-size: 0.7rem;">
                                            +@(train.Classes.Count - 3) more
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="user-actions">
                            <button class="action-btn action-btn-edit" @onclick="() => EditTrain(train)" disabled="@(isCreating || isUpdating)">
                                <i class="fas fa-edit me-1"></i>Edit
                            </button>
                            <button class="action-btn @(train.IsActive ? "action-btn-delete" : "action-btn-edit")" 
                                    @onclick="() => ToggleTrainStatus(train)" 
                                    disabled="@(isCreating || isUpdating)">
                                <i class="fas @(train.IsActive ? "fa-pause" : "fa-play") me-1"></i>
                                @(train.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Add/Edit Train Modal -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content-custom" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <h3 class="modal-title-custom">
                    <i class="fas fa-train me-2"></i>
                    @(isEditing ? "Update Train" : "Create New Train")
                </h3>
                <button class="close-btn" @onclick="CloseModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <EditForm Model="@(isEditing ? updateTrainCommand : (object)newTrainCommand)" OnValidSubmit="@(isEditing ? UpdateTrain : CreateTrain)">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger-custom" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Train Number</label>
                        @if (isEditing)
                        {
                            <InputText class="form-control form-control-custom" @bind-Value="updateTrainCommand.TrainNumber" placeholder="e.g., 12043" />
                        }
                        else
                        {
                            <InputText class="form-control form-control-custom" @bind-Value="newTrainCommand.TrainNumber" placeholder="e.g., 12043" />
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Train Name</label>
                        @if (isEditing)
                        {
                            <InputText class="form-control form-control-custom" @bind-Value="updateTrainCommand.Name" placeholder="e.g., Shatabdi Express" />
                        }
                        else
                        {
                            <InputText class="form-control form-control-custom" @bind-Value="newTrainCommand.Name" placeholder="e.g., Shatabdi Express" />
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Train Type</label>
                        @if (isEditing)
                        {
                            <InputSelect class="form-control form-control-custom" @bind-Value="updateTrainCommand.TrainType">
                                <option value="">Select Type</option>
                                <option value="Express">Express</option>
                                <option value="Superfast">Superfast</option>
                                <option value="Passenger">Passenger</option>
                                <option value="Mail">Mail</option>
                                <option value="Shatabdi">Shatabdi</option>
                                <option value="Rajdhani">Rajdhani</option>
                                <option value="Duronto">Duronto</option>
                                <option value="Vande Bharat">Vande Bharat</option>
                            </InputSelect>
                        }
                        else
                        {
                            <InputSelect class="form-control form-control-custom" @bind-Value="newTrainCommand.TrainType">
                                <option value="">Select Type</option>
                                <option value="Express">Express</option>
                                <option value="Superfast">Superfast</option>
                                <option value="Passenger">Passenger</option>
                                <option value="Mail">Mail</option>
                                <option value="Shatabdi">Shatabdi</option>
                                <option value="Rajdhani">Rajdhani</option>
                                <option value="Duronto">Duronto</option>
                                <option value="Vande Bharat">Vande Bharat</option>
                            </InputSelect>
                        }
                    </div>

                    @if (isEditing)
                    {
                        <div class="col-md-6">
                            <label class="form-label-custom">Status</label>
                            <div class="form-check form-switch p-3 rounded-3" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.2);">
                                <InputCheckbox class="form-check-input" @bind-Value="updateTrainCommand.IsActive" />
                                <label class="form-check-label form-label-custom">
                                    @(updateTrainCommand.IsActive ? "Active" : "Inactive")
                                </label>
                            </div>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label-custom">Total Seats</label>
                        @if (isEditing)
                        {
                            <InputNumber class="form-control form-control-custom" @bind-Value="updateTrainCommand.TotalSeats" min="1" max="2000" />
                        }
                        else
                        {
                            <InputNumber class="form-control form-control-custom" @bind-Value="newTrainCommand.TotalSeats" min="1" max="2000" />
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label-custom">
                            <i class="fas fa-couch me-2"></i>Train Classes
                        </label>
                        @{
                            var currentClasses = isEditing ? updateTrainCommand.Classes : newTrainCommand.Classes;
                        }
                        @for (int i = 0; i < currentClasses.Count; i++)
                        {
                            var index = i;
                            <div class="user-card mb-3" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.2);">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Class Name</label>
                                        <InputSelect class="form-control form-control-custom" @bind-Value="currentClasses[index].ClassName">
                                            <option value="">Select Class</option>
                                            <option value="AC First Class">AC First Class</option>
                                            <option value="AC 2 Tier">AC 2 Tier</option>
                                            <option value="AC 3 Tier">AC 3 Tier</option>
                                            <option value="Sleeper">Sleeper</option>
                                            <option value="General">General</option>
                                            <option value="Chair Car">Chair Car</option>
                                            <option value="Executive Chair Car">Executive Chair Car</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Seat Count</label>
                                        <InputNumber class="form-control form-control-custom" @bind-Value="currentClasses[index].SeatCount" min="1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label-custom" style="font-size: 0.85rem;">Base Price (₹)</label>
                                        <InputNumber class="form-control form-control-custom" @bind-Value="currentClasses[index].BasePrice" min="0" step="0.01" />
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="button" class="action-btn action-btn-delete w-100" @onclick="() => RemoveClass(index)" style="padding: 0.5rem;">
                                            <i class="fas fa-trash me-1"></i>Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        <button type="button" class="add-user-btn btn-sm" @onclick="AddClass" style="padding: 0.5rem 1.5rem;">
                            <i class="fas fa-plus-circle"></i>Add Class
                        </button>
                    </div>

                    <div class="col-12 d-flex gap-2 justify-content-end mt-4">
                        <button type="button" class="cancel-btn" @onclick="CloseModal">
                            Cancel
                        </button>
                        <button type="submit" class="submit-btn" disabled="@(isCreating || isUpdating)">
                            @if (isEditing)
                            {
                                @if (isUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <text>Updating...</text>
                                }
                                else
                                {
                                    <i class="fas fa-save me-2"></i>
                                    <text>Update Train</text>
                                }
                            }
                            else
                            {
                                @if (isCreating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <text>Creating...</text>
                                }
                                else
                                {
                                    <i class="fas fa-plus-circle me-2"></i>
                                    <text>Create Train</text>
                                }
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private CreateTrainCommand newTrainCommand = new CreateTrainCommand();
    private UpdateTrainCommand updateTrainCommand = new UpdateTrainCommand();
    private List<Train> trains = new List<Train>();
    private bool isCreating = false;
    private bool isUpdating = false;
    private bool isEditing = false;
    private bool showModal = false;
    private string selectedTrainId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!newTrainCommand.Classes.Any())
        {
            newTrainCommand.Classes.Add(new TrainClass());
        }

        await LoadTrains();
    }

    private async Task LoadTrains()
    {
        try
        {
            trains = await Mediator.Send(new GetAllTrainsQuery());
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error loading trains: {ex.Message}");
        }
    }

    private void OpenAddTrainModal()
    {
        isEditing = false;
        showModal = true;
        newTrainCommand = new CreateTrainCommand();
        newTrainCommand.Classes.Add(new TrainClass());
        updateTrainCommand = new UpdateTrainCommand();
        selectedTrainId = string.Empty;
    }

    private void CloseModal()
    {
        showModal = false;
        if (!isEditing)
        {
            CancelEdit();
        }
    }

    private async Task CreateTrain()
    {
        isCreating = true;

        try
        {
            var validClasses = newTrainCommand.Classes
                .Where(c => !string.IsNullOrWhiteSpace(c.ClassName) && c.SeatCount > 0)
                .ToList();

            if (!validClasses.Any())
            {
                await JSRuntime.InvokeVoidAsync("showError", "Please add at least one train class with valid seat count.");
                isCreating = false;
                return;
            }

            newTrainCommand.Classes = validClasses;
            newTrainCommand.TotalSeats = validClasses.Sum(c => c.SeatCount);

            var trainId = await Mediator.Send(newTrainCommand);
            await JSRuntime.InvokeVoidAsync("showSuccess", "Train created successfully!");

            newTrainCommand = new CreateTrainCommand();
            newTrainCommand.Classes.Add(new TrainClass());
            showModal = false;

            await LoadTrains();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error creating train: {ex.Message}");
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task UpdateTrain()
    {
        isUpdating = true;

        try
        {
            var validClasses = updateTrainCommand.Classes
                .Where(c => !string.IsNullOrWhiteSpace(c.ClassName) && c.SeatCount > 0)
                .ToList();

            if (!validClasses.Any())
            {
                await JSRuntime.InvokeVoidAsync("showError", "Please add at least one train class with valid seat count.");
                isUpdating = false;
                return;
            }

            updateTrainCommand.Classes = validClasses;
            updateTrainCommand.TotalSeats = validClasses.Sum(c => c.SeatCount);

            var result = await Mediator.Send(updateTrainCommand);

            if (result)
            {
                await JSRuntime.InvokeVoidAsync("showSuccess", "Train updated successfully!");
                CancelEdit();
                showModal = false;
                await LoadTrains();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showError", "Failed to update train. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error updating train: {ex.Message}");
        }
        finally
        {
            isUpdating = false;
        }
    }

    private void EditTrain(Train train)
    {
        isEditing = true;
        selectedTrainId = train.Id;
        showModal = true;

        updateTrainCommand = new UpdateTrainCommand
        {
            Id = train.Id,
            TrainNumber = train.TrainNumber,
            Name = train.Name,
            TrainType = train.TrainType,
            TotalSeats = train.TotalSeats,
            IsActive = train.IsActive,
            RouteIds = new List<string>(train.RouteIds ?? new List<string>()),
            Classes = train.Classes?.Select(c => new TrainClass
            {
                ClassName = c.ClassName,
                SeatCount = c.SeatCount,
                BasePrice = c.BasePrice,
                Amenities = new List<string>(c.Amenities ?? new List<string>())
            }).ToList() ?? new List<TrainClass>()
        };

        if (!updateTrainCommand.Classes.Any())
        {
            updateTrainCommand.Classes.Add(new TrainClass());
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        selectedTrainId = string.Empty;
        updateTrainCommand = new UpdateTrainCommand();
    }

    private async Task ToggleTrainStatus(Train train)
    {
        try
        {
            var updateCommand = new UpdateTrainCommand
            {
                Id = train.Id,
                TrainNumber = train.TrainNumber,
                Name = train.Name,
                TrainType = train.TrainType,
                TotalSeats = train.TotalSeats,
                IsActive = !train.IsActive,
                RouteIds = train.RouteIds ?? new List<string>(),
                Classes = train.Classes ?? new List<TrainClass>()
            };

            var result = await Mediator.Send(updateCommand);

            if (result)
            {
                await JSRuntime.InvokeVoidAsync("showSuccess", $"Train {(train.IsActive ? "deactivated" : "activated")} successfully!");
                await LoadTrains();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("showError", "Failed to update train status.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showError", $"Error updating train status: {ex.Message}");
        }
    }

    private void AddClass()
    {
        if (isEditing)
        {
            updateTrainCommand.Classes.Add(new TrainClass());
        }
        else
        {
            newTrainCommand.Classes.Add(new TrainClass());
        }
    }

    private void RemoveClass(int index)
    {
        var currentClasses = isEditing ? updateTrainCommand.Classes : newTrainCommand.Classes;
        if (currentClasses.Count > 1)
        {
            currentClasses.RemoveAt(index);
        }
        else
        {
            JSRuntime.InvokeVoidAsync("showWarning", "At least one class is required.");
        }
    }
}
