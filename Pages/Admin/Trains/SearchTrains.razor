    .train-info .train-name {
        color: #1565c0;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .train-type {
        background: #e3f2fd;
        color: #1565c0;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 12px;
    }

    .running-days {
        margin-top: 8px;
    }

    .day-badge {
        display: inline-block;
        width: 20px;
        height: 20px;
        background: #4caf50;
        color: white;
        text-align: center;
        border-radius: 50%;
        font-size: 10px;
        line-height: 20px;
        margin-right: 3px;
