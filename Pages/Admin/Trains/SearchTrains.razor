        color: #666;
        margin-bottom: 8px;
    }

    .line {
        height: 2px;
        background: linear-gradient(90deg, #1565c0 0%, #42a5f5 100%);
        position: relative;
    }

    .line::before, .line::after {
        content: '';
        position: absolute;
        width: 8px;
        height: 8px;
        background: #1565c0;
        border-radius: 50%;
        top: -3px;
    }

    .line::before {
