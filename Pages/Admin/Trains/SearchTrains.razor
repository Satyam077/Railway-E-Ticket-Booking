        background: #f57c00;
        transform: rotate(180deg);
    }

    .quota-select {
        max-width: 200px;
    }

    .checkbox-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin: 20px 0;
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        border: 2px solid #1565c0;
    }

    .form-check-label {
        font-size: 14px;
        color: #333;
        margin: 0;
    }

    .search-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 25px;
    }

    .btn-search {
        background: linear-gradient(45deg, #ff6b35, #f7931e);
        border: none;
        color: white;
        padding: 15px 40px;
