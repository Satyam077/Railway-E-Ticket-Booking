@page "/"
@using MediatR
@using Railway_Ticket_Booking.Application.TrainSchedules.Queries
@using Railway_Ticket_Booking.Application.Routes.Queries
@using Railway_Ticket_Booking.Domain.Entities
@inject IMediator Mediator
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="search-container">
    <!-- Header Section -->
    <div class="header-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <div class="logo-placeholder">
                        <i class="fas fa-train fa-3x text-primary"></i>
                    </div>
                </div>
                <div class="col-md-8 text-center">
                    <h1 class="railway-title">INDIAN RAILWAYS</h1>
                    <p class="railway-subtitle">Safety | Security | Punctuality</p>
                </div>
                <div class="col-md-2 text-end">
                    <div class="logo-placeholder">
                        <i class="fas fa-ticket-alt fa-3x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="nav-tabs-section">
        <div class="container">
            <div class="nav-tabs-container">
                <button class="nav-tab active">
                    <i class="fas fa-check-square"></i>
                    PNR STATUS
                </button>
                <button class="nav-tab active">
                    <i class="fas fa-check-square"></i>
                    CHARTS / VACANCY
                </button>
                <button class="nav-tab active" @onclick="NavigateLogin">
                    <i class="fas fa-check-square"></i>
                    Login
                </button>
            </div>
        </div>
    </div>

    <!-- Search Form Section -->
    <div class="search-form-section">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <div class="search-form-card">
                        <h2 class="form-title">BOOK TICKET</h2>
                        
                        <EditForm Model="searchQuery" OnValidSubmit="HandleSearchTrains">
                            <div class="row g-3">
                                <!-- From Station -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fas fa-map-marker-alt text-primary"></i>
                                            From
                                        </label>
                                        <InputSelect class="form-control search-input" @bind-Value="searchQuery.FromStationId">
                                            <option value="">Select Station</option>
                                            @foreach (var station in stations)
                                            {
                                                <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>

                                <!-- Date -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">DD/MM/YYYY *</label>
                                        <InputDate class="form-control search-input" @bind-Value="searchQuery.TravelDate" />
                                    </div>
                                </div>

                                <!-- Swap Button -->
                                <div class="col-12 text-center">
                                    <button type="button" class="btn-swap" @onclick="SwapStations">
                                        <i class="fas fa-exchange-alt"></i>
                                    </button>
                                </div>

                                <!-- To Station -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">
                                            <i class="fas fa-map-marker-alt text-danger"></i>
                                            To
                                        </label>
                                        <InputSelect class="form-control search-input" @bind-Value="searchQuery.ToStationId">
                                            <option value="">Select Station</option>
                                            @foreach (var station in stations)
                                            {
                                                <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>

                                <!-- Class Selection -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <InputSelect class="form-control search-input" @bind-Value="searchQuery.Class">
                                            <option value="All Classes">All Classes</option>
                                            <option value="AC First Class">AC First Class (1A)</option>
                                            <option value="AC 2 Tier">AC 2 Tier (2A)</option>
                                            <option value="AC 3 Tier">AC 3 Tier (3A)</option>
                                            <option value="Sleeper">Sleeper (SL)</option>
                                            <option value="Second Sitting">Second Sitting (2S)</option>
                                            <option value="Chair Car">Chair Car (CC)</option>
                                        </InputSelect>
                                    </div>
                                </div>

                                <!-- Quota Selection -->
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <InputSelect class="form-control search-input quota-select" @bind-Value="searchQuery.Quota">
                                            <option value="GENERAL">GENERAL</option>
                                            <option value="LADIES">LADIES</option>
                                            <option value="SENIOR CITIZEN">SENIOR CITIZEN</option>
                                            <option value="TATKAL">TATKAL</option>
                                            <option value="PREMIUM TATKAL">PREMIUM TATKAL</option>
                                        </InputSelect>
                                    </div>
                                </div>

                                <!-- Checkboxes -->
                                <div class="col-md-12">
                                    <div class="checkbox-group">
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="searchQuery.PersonWithDisability" />
                                            <label class="form-check-label">Person With Disability Concession</label>
                                        </div>
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="searchQuery.FlexibleWithDate" />
                                            <label class="form-check-label">Flexible With Date</label>
                                        </div>
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="searchQuery.TrainWithAvailableBerth" />
                                            <label class="form-check-label">Train with Available Berth</label>
                                        </div>
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="searchQuery.RailwayPassConcession" />
                                            <label class="form-check-label">Railway Pass Concession</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Search Buttons -->
                                <div class="col-md-12">
                                    <div class="search-buttons">
                                        <button type="submit" class="btn btn-search" disabled="@isSearching">
                                            @if (isSearching)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            Search 
                                        </button>
                                        <button type="button" class="btn btn-easy-booking">
                                            Easy Booking on AskDISHA
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="train-image-container">
                        <div class="train-placeholder">
                            <i class="fas fa-train fa-5x text-primary"></i>
                            <p class="mt-2 text-muted">Vande Bharat Express</p>
                        </div>
                        <div class="train-badge">
                            <div class="avatar-circle">
                                <i class="fas fa-user"></i>
                            </div>
                            <span>Ask DISHA</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Results Section -->
    @if (searchResults != null && searchResults.Any())
    {
        <div class="search-results-section">
            <div class="container">
                <div class="results-header">
                    <h3>Available Trains</h3>
                    <p class="text-muted">@searchResults.Count trains found for @GetStationName(searchQuery.FromStationId) to @GetStationName(searchQuery.ToStationId) on @searchQuery.TravelDate.ToString("dd MMM yyyy")</p>
                </div>

                @foreach (var train in searchResults)
                {
                    <div class="train-card">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <div class="train-info">
                                    <h5 class="train-name">@train.TrainNumber - @train.TrainName</h5>
                                    <span class="train-type badge badge-secondary">@train.TrainType</span>
                                    <div class="running-days">
                                        <small class="text-muted">Runs on: </small>
                                        @foreach (var day in train.RunsOn.Take(7))
                                        {
                                            <span class="day-badge">@day</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="timing-info">
                                    <div class="departure">
                                        <div class="time">@train.DepartureTime.ToString("HH:mm")</div>
                                        <div class="station">@train.FromStationCode</div>
                                    </div>
                                    <div class="journey-line">
                                        <div class="duration">@FormatDuration(train.Duration)</div>
                                        <div class="line"></div>
                                    </div>
                                    <div class="arrival">
                                        <div class="time">@train.ArrivalTime.ToString("HH:mm")</div>
                                        <div class="station">@train.ToStationCode</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="class-info">
                                    @foreach (var classInfo in train.Classes.Take(3))
                                    {
                                        <div class="class-item">
                                            <span class="class-name">@classInfo.ClassName</span>
                                            <span class="fare">Rs.@classInfo.Fare.ToString("N0")</span>
                                            <span class="availability @GetAvailabilityClass(classInfo.Status)">@classInfo.Status</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-book" @onclick="() => BookTrain(train)">
                                    Book Now
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (hasSearched && (searchResults == null || !searchResults.Any()))
    {
        <div class="no-results-section">
            <div class="container text-center">
                <div class="no-results-card">
                    <i class="fas fa-train fa-3x text-muted mb-3"></i>
                    <h4>No Trains Found</h4>
                    <p class="text-muted">No trains available for the selected route and date. Please try different stations or date.</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SearchTrainsQuery searchQuery = new SearchTrainsQuery();
    private List<TrainSearchResult> searchResults = new List<TrainSearchResult>();
    private List<Station> stations = new List<Station>();
    private bool isSearching = false;
    private bool hasSearched = false;

    protected override async Task OnInitializedAsync()
    {
        searchQuery.TravelDate = DateTime.Today.AddDays(1);
        await LoadStations();
    }

    private async Task LoadStations()
    {
        try
        {
            stations = await Mediator.Send(new GetAllStationsQuery());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stations: {ex.Message}");
        }
    }

    private async Task HandleSearchTrains()
    {
        if (string.IsNullOrEmpty(searchQuery.FromStationId) || string.IsNullOrEmpty(searchQuery.ToStationId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select both From and To stations.");
            return;
        }

        if (searchQuery.FromStationId == searchQuery.ToStationId)
        {
            await JSRuntime.InvokeVoidAsync("alert", "From and To stations cannot be the same.");
            return;
        }

        isSearching = true;
        hasSearched = false;

        try
        {
            searchResults = await Mediator.Send(searchQuery);
            hasSearched = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error searching trains: {ex.Message}");
        }
        finally
        {
            isSearching = false;
        }
    }

    private void SwapStations()
    {
        var temp = searchQuery.FromStationId;
        searchQuery.FromStationId = searchQuery.ToStationId;
        searchQuery.ToStationId = temp;
    }

    private async Task BookTrain(TrainSearchResult train)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"Booking functionality for {train.TrainName} will be implemented soon!");
    }

    private string GetStationName(string stationId)
    {
        var station = stations.FirstOrDefault(s => s.Id == stationId);
        return station?.StationName ?? "Unknown";
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.Days > 0)
        {
            return $"{duration.Days}d {duration.Hours}h {duration.Minutes}m";
        }
        return $"{duration.Hours}h {duration.Minutes}m";
    }

    private string GetAvailabilityClass(string status)
    {
        return status.ToLower() switch
        {
            "available" => "text-success",
            "waiting list" => "text-warning",
            "rac" => "text-info",
            _ => "text-secondary"
        };
    }
    public void NavigateLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}

<style>
    .search-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    }

    .header-section {
        background: linear-gradient(90deg, #1565c0 0%, #0d47a1 100%);
