        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: #f8f9fa;
        border-radius: 6px;
        font-size: 14px;
    }

    .class-name {
        font-weight: 500;
        color: #333;
    }

    .fare {
