        font-weight: bold;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .railway-subtitle {
        font-size: 1rem;
        margin: 0;
        opacity: 0.9;
    }

    .logo-placeholder {
        text-align: center;
        padding: 10px;
    }

    .nav-tabs-section {
        background: #1976d2;
        padding: 0;
    }

    .nav-tabs-container {
        display: flex;
        gap: 0;
    }

    .nav-tab {
        background: #1565c0;
