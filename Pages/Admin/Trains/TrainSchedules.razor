@page "/train-schedules"
@using MediatR
@using Railway_Ticket_Booking.Application.TrainSchedules.Commands
@using Railway_Ticket_Booking.Application.TrainSchedules.Queries
@using Railway_Ticket_Booking.Application.Queries
@using Railway_Ticket_Booking.Application.Routes.Queries
@using Railway_Ticket_Booking.Domain.Entities
@inject IMediator Mediator
@inject IJSRuntime JSRuntime

<h3 class="text-center">Train Schedule Management</h3>

<div class="row">
    <!-- FORM -->
    <div class="col-md-5">
        <h4>@(isEditing ? "Edit Schedule" : "Create Schedule")</h4>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">@message</div>
        }

        <EditForm Model="@(isEditing ? (object)updateCommand : (object)createCommand)" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- SELECT TRAIN -->
            <div class="mb-3">
                <label>Train</label>
                @if (isEditing)
                {
                    <InputSelect class="form-control" @bind-Value="updateCommand.TrainId">
                        <option value="">-- Select --</option>
                        @foreach (var t in trains)
                        {
                            <option value="@t.Id">@t.DisplayName</option>
                        }
                    </InputSelect>
                }
                else
                {
                    <InputSelect class="form-control" @bind-Value="createCommand.TrainId">
                        <option value="">-- Select --</option>
                        @foreach (var t in trains)
                        {
                            <option value="@t.Id">@t.DisplayName</option>
                        }
                    </InputSelect>
                }
            </div>

            <!-- SELECT ROUTE -->
            <div class="mb-3">
                <label>Route</label>
                @if (isEditing)
                {
                    <InputSelect class="form-control"
                                 @bind-Value="updateCommand.RouteId"
                                 @onchange="OnRouteChanged">
                        <option value="">-- Select --</option>
                        @foreach (var r in routes)
                        {
                            <option value="@r.Id">@GetRouteDisplay(r)</option>
                        }
                    </InputSelect>
                }
                else
                {
                    <InputSelect class="form-control"
                                 @bind-Value="createCommand.RouteId"
                                 @onchange="OnRouteChanged">

                        <option value="">-- Select --</option>
                        @foreach (var r in routes)
                        {
                            <option value="@r.Id">@GetRouteDisplay(r)</option>
                        }
                    </InputSelect>
                }
            </div>

            <!-- RUN DAYS -->
            <div class="mb-3">
                <label>Runs On</label>
                <div class="d-flex gap-1 flex-wrap">
                    @foreach (DayOfWeek d in Enum.GetValues(typeof(DayOfWeek)))
                    {
                        var runsOnList = isEditing ? updateCommand.RunsOn : createCommand.RunsOn;
                        bool selected = runsOnList?.Contains(d) == true;
                        <button type="button"
                                class="btn @(selected ? "btn-primary" : "btn-outline-primary") btn-sm"
                                @onclick="@(() => ToggleDay(d))">
                            @d.ToString().Substring(0, 3)
                        </button>
                    }
                </div>
            </div>

            <hr />
            <h5>Stations</h5>

            <!-- STATIONS -->
            @for (int i = 0; i < StationsList.Count; i++)
            {
                var st = StationsList[i];
                <div class="card mb-2">
                    <div class="card-body">

                        <div class="row g-2">
                            <div class="col-md-4">
                                <label>Station</label>
                                <InputSelect class="form-control" @bind-Value="st.StationId">
                                    <option value="">Select</option>
                                    @foreach (var s in stations)
                                    {
                                        <option value="@s.Id">@s.StationName (@s.StationCode)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-2">
                                <label>Order</label>
                                <InputNumber class="form-control" @bind-Value="st.StationOrder" />
                            </div>

                            <div class="col-md-2">
                                <label>DayOffset</label>
                                <InputNumber class="form-control" @bind-Value="st.DayOffset" />
                            </div>

                            <div class="col-md-2">
                                <label>Arr</label>
                                <input type="time"
                                       class="form-control"
                                       value="@st.ArrivalTime.ToString(@"hh\:mm")"
                                       @onchange="e => UpdateTime(st, e.Value?.ToString(), true)" />
                            </div>

                            <div class="col-md-2">
                                <label>Dep</label>
                                <input type="time"
                                       class="form-control"
                                       value="@st.DepartureTime.ToString(@"hh\:mm")"
                                       @onchange="e => UpdateTime(st, e.Value?.ToString(), false)" />
                            </div>
                        </div>

                        <div class="row mt-2 g-2">
                            <div class="col-md-3">
                                <label>Halt</label>
                                <InputNumber class="form-control" @bind-Value="st.HaltMinutes" />
                            </div>

                            <div class="col-md-3">
                                <label>Major</label>
                                <InputCheckbox @bind-Value="st.IsMajorStation" class="form-check-input mt-2" />
                            </div>

                            <div class="col-md-4">
                                <label>Platform</label>
                                <InputText class="form-control" @bind-Value="st.PlatformNumber" />
                            </div>

                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-danger btn-sm"
                                        @onclick="() => RemoveStation(i)">
                                    Remove
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }

            <button type="button" class="btn btn-secondary btn-sm" @onclick="AddStation">
                Add Station
            </button>

            <hr />
            
            <!-- IS ACTIVE -->
            <div class="mb-3">
                <div class="form-check">
                    @if (isEditing)
                    {
                        <InputCheckbox class="form-check-input" @bind-Value="updateCommand.IsActive" id="isActive" />
                    }
                    else
                    {
                        <InputCheckbox class="form-check-input" @bind-Value="createCommand.IsActive" id="isActive" />
                    }
                    <label class="form-check-label" for="isActive">
                        Active Schedule
                    </label>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    @((isEditing ? "Update" : "Create"))
                </button>

                @if (isEditing)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                }
            </div>

        </EditForm>

    </div>

    <!-- RIGHT LIST -->
    <div class="col-md-7">
        <h4>All Schedules</h4>

        @if (trainSchedules == null)
        {
            <div>Loading...</div>
        }
        else if (!trainSchedules.Any())
        {
            <div class="alert alert-info">No schedules yet.</div>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Train</th>
                        <th>Route</th>
                        <th>Runs</th>
                        <th>Stations</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in trainSchedules)
                    {
                        <tr>
                            <td>@GetTrainName(s.TrainId)</td>
                            <td>@GetRouteDisplayById(s.RouteId)</td>
                            <td>@(s.RunsOn?.Any() == true ? string.Join(", ", s.RunsOn) : "Daily")</td>
                            <td>@s.Stations.Count</td>
                            <td>@(s.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => EditSchedule(s)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteSchedule(s.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        }
    </div>
</div>

@code {

    // Models
    private CreateTrainScheduleCommand createCommand = new CreateTrainScheduleCommand();
    private UpdateTrainScheduleCommand updateCommand = new UpdateTrainScheduleCommand();


    // Data
    private List<TrainSchedule> trainSchedules = new();
    private List<Train> trains = new();
    private List<Route> routes = new();
    private List<Station> stations = new();

    // UI
    private bool isEditing = false;
    private string message = "";
    private bool isSuccess = false;

    private List<ScheduleStation> StationsList =>
        isEditing ? updateCommand.Stations : createCommand.Stations;

    protected override async Task OnInitializedAsync()
    {
        trains = await Mediator.Send(new GetAllTrainsQuery());
        routes = await Mediator.Send(new GetAllRoutesQuery());
        stations = await Mediator.Send(new GetAllStationsQuery());
        trainSchedules = await Mediator.Send(new GetAllTrainSchedulesQuery());

        // Ensure Stations lists are initialized
        if (createCommand.Stations == null)
            createCommand.Stations = new List<ScheduleStation>();
        if (updateCommand.Stations == null)
            updateCommand.Stations = new List<ScheduleStation>();
        if (createCommand.RunsOn == null)
            createCommand.RunsOn = new List<DayOfWeek>();
        if (updateCommand.RunsOn == null)
            updateCommand.RunsOn = new List<DayOfWeek>();

        if (!createCommand.Stations.Any())
            AddStation();
    }

    private void AddStation()
    {
        int order = StationsList.Any() ? StationsList.Max(x => x.StationOrder) + 1 : 1;

        StationsList.Add(new ScheduleStation
            {
                StationOrder = order,
                ArrivalTime = TimeSpan.FromHours(8),
                DepartureTime = TimeSpan.FromHours(8.1),
                HaltMinutes = 5,
                IsMajorStation = false
            });
        
        StateHasChanged();
    }

    private void RemoveStation(int i)
    {
        if (i >= 0 && i < StationsList.Count)
        {
            StationsList.RemoveAt(i);
            StateHasChanged();
        }
    }

    private void ToggleDay(DayOfWeek d)
    {
        var list = isEditing ? updateCommand.RunsOn : createCommand.RunsOn;
        
        if (list == null)
        {
            list = new List<DayOfWeek>();
            if (isEditing)
                updateCommand.RunsOn = list;
            else
                createCommand.RunsOn = list;
        }

        if (list.Contains(d)) 
            list.Remove(d);
        else 
            list.Add(d);
        
        StateHasChanged();
    }

    private void UpdateTime(ScheduleStation st, string? val, bool isArr)
    {
        if (TimeSpan.TryParse(val, out var t))
        {
            if (isArr) st.ArrivalTime = t;
            else st.DepartureTime = t;
            StateHasChanged();
        }
    }

    private void OnRouteChanged(ChangeEventArgs e)
    {
        string routeId = e.Value?.ToString();
        var route = routes.FirstOrDefault(r => r.Id == routeId);
        if (route == null || route.Stations == null) return;

        StationsList.Clear();

        int o = 1;
        foreach (var rs in route.Stations.OrderBy(x => x.StationOrder))
        {
            StationsList.Add(new ScheduleStation
                {
                    StationId = rs.StationId ?? string.Empty,
                    StationOrder = o++,
                    DayOffset = rs.DayOffset,
                    ArrivalTime = rs.ArrivalTime,
                    DepartureTime = rs.DepartureTime,
                    HaltMinutes = rs.HaltMinutes, // This uses the computed property from RouteStation
                    PlatformNumber = rs.PlatformNumber ?? string.Empty,
                    IsMajorStation = rs.IsMajorStation
                });
        }
        
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        message = "";
        isSuccess = false;

        try
        {
            if (isEditing)
            {
                var ok = await Mediator.Send(updateCommand);
                isSuccess = ok;
                message = ok ? "Schedule updated successfully." : "Update failed. Please check the data and try again.";
                
                if (ok)
                {
                    isEditing = false;
                    updateCommand = new UpdateTrainScheduleCommand();
                    updateCommand.Stations = new List<ScheduleStation>();
                    updateCommand.RunsOn = new List<DayOfWeek>();
                }
            }
            else
            {
                var id = await Mediator.Send(createCommand);
                isSuccess = !string.IsNullOrEmpty(id);
                message = isSuccess ? "Schedule created successfully." : "Create failed. Please check the data and try again.";

                if (isSuccess)
                {
                    createCommand = new CreateTrainScheduleCommand();
                    createCommand.Stations = new List<ScheduleStation>();
                    createCommand.RunsOn = new List<DayOfWeek>();
                    AddStation();
                }
            }

            trainSchedules = await Mediator.Send(new GetAllTrainSchedulesQuery());
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Error: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void EditSchedule(TrainSchedule s)
    {
        isEditing = true;
        message = "";

        updateCommand = new UpdateTrainScheduleCommand
            {
                Id = s.Id,
                TrainId = s.TrainId,
                RouteId = s.RouteId,
                RunsOn = s.RunsOn?.ToList() ?? new List<DayOfWeek>(),
                IsActive = s.IsActive,
                Stations = s.Stations?.Select(x => new ScheduleStation
                {
                    StationId = x.StationId,
                    StationOrder = x.StationOrder,
                    DayOffset = x.DayOffset,
                    ArrivalTime = x.ArrivalTime,
                    DepartureTime = x.DepartureTime,
                    HaltMinutes = x.HaltMinutes,
                    PlatformNumber = x.PlatformNumber,
                    IsMajorStation = x.IsMajorStation
                }).ToList() ?? new List<ScheduleStation>()
            };
        
        StateHasChanged();
    }

    private void CancelEdit()
    {
        isEditing = false;
        updateCommand = new UpdateTrainScheduleCommand();
        message = "";
        StateHasChanged();
    }

    private async Task DeleteSchedule(string id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Delete schedule?")) return;

        try
        {
            var result = await Mediator.Send(new DeleteTrainScheduleCommand(id));
            if (result)
            {
                trainSchedules = await Mediator.Send(new GetAllTrainSchedulesQuery());
                message = "Schedule deleted successfully.";
                isSuccess = true;
            }
            else
            {
                message = "Delete failed.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string GetTrainName(string id) =>
        trains.FirstOrDefault(t => t.Id == id)?.DisplayName ?? "Unknown";

    private string GetRouteDisplay(Route r) =>
        $"{GetStationName(r.SourceStationId)} → {GetStationName(r.DestinationStationId)}";

    private string GetRouteDisplayById(string id) =>
        GetRouteDisplay(routes.FirstOrDefault(r => r.Id == id));

    private string GetStationName(string id) =>
        stations.FirstOrDefault(s => s.Id == id)?.StationName ?? "Unknown";
}
