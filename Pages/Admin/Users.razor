@page "/users-registration"
@using MediatR
@using RailwayTicketBooking.Application.Account.Commands
@inject IMediator Mediator
@inject NavigationManager Navigation

<div class="user-management-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="modal-content-custom" style="margin-top: 3rem;">
                    <div class="modal-header-custom">
                        <h2 class="modal-title-custom">
                            <i class="bi bi-person-plus-fill me-2"></i>
                            Create Your Account
                        </h2>
                    </div>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="@(isSuccess ? "alert-success-custom" : "alert-danger-custom") alert-custom">
                            <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                            @message
                        </div>
                    }

                    <EditForm Model="@newUserCommand" OnValidSubmit="@CreateUser">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-person me-1"></i>First Name <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.FirstName" placeholder="Enter first name" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-person me-1"></i>Last Name <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.LastName" placeholder="Enter last name" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-custom">
                                <i class="bi bi-envelope me-1"></i>Email Address <span class="text-danger">*</span>
                            </label>
                            <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.Email" type="email" placeholder="your.email@example.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-custom">
                                <i class="bi bi-telephone me-1"></i>Phone Number <span class="text-danger">*</span>
                            </label>
                            <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.PhoneNumber" placeholder="+91 1234567890" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-custom">
                                <i class="bi bi-lock me-1"></i>Password <span class="text-danger">*</span>
                            </label>
                            <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.Password" type="password" placeholder="Create a strong password" />
                            <small class="text-muted">Password should be at least 6 characters long</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-calendar me-1"></i>Date of Birth <span class="text-danger">*</span>
                                </label>
                                <InputDate class="form-control form-control-custom" @bind-Value="newUserCommand.DateOfBirth" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-gender-ambiguous me-1"></i>Gender <span class="text-danger">*</span>
                                </label>
                                <InputSelect class="form-control form-control-custom" @bind-Value="newUserCommand.Gender">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-custom">
                                <i class="bi bi-house me-1"></i>Address
                            </label>
                            <InputTextArea class="form-control form-control-custom" @bind-Value="newUserCommand.Address" rows="2" placeholder="Enter your full address" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-building me-1"></i>City
                                </label>
                                <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.City" placeholder="City" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-map me-1"></i>State
                                </label>
                                <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.State" placeholder="State" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-mailbox me-1"></i>Pin Code
                                </label>
                                <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.PinCode" placeholder="123456" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label-custom">
                                    <i class="bi bi-globe me-1"></i>Country
                                </label>
                                <InputText class="form-control form-control-custom" @bind-Value="newUserCommand.Country" placeholder="India" />
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="submit-btn" disabled="@isCreating">
                                @if (isCreating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <text>Creating Account...</text>
                                }
                                else
                                {
                                    <i class="bi bi-person-check me-2"></i>
                                    <text>Register Now</text>
                                }
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small style="background: linear-gradient(135deg, #f093fb, #f5576c); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                                Already have an account? 
                                <a href="/login" class="text-white fw-bold text-decoration-none">Login here</a>
                            </small>
                        </div>
                    </EditForm>
                </div>

                <div class="text-center mt-3">
                    <small style="color: rgba(255, 255, 255, 0.9);">
                        <i class="bi bi-shield-check me-1"></i>
                        Your information is safe and secure with us
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateUserCommand newUserCommand = new CreateUserCommand();
    private string message = string.Empty;
    private bool isSuccess = false;
    private bool isCreating = false;

    protected override void OnInitialized()
    {
        newUserCommand.Role = UserRole.Customer;
    }

    private async Task CreateUser()
    {
        isCreating = true;
        message = string.Empty;

        try
        {
            newUserCommand.Role = UserRole.Customer;

            var result = await Mediator.Send(newUserCommand);
            
            if (result.IsSuccess)
            {
                message = "Registration successful! Your account has been created. Redirecting to login...";
                isSuccess = true;
                
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                message = result.Message ?? "Registration failed. Please try again.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            message = $"Error during registration: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isCreating = false;
        }
    }
}