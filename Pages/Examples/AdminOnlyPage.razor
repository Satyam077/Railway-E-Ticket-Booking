@page "/admin-only"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

<PageTitle>Admin Only Page</PageTitle>

<div class="container mt-4">
    <div class="alert alert-success">
        <h3>Welcome, Admin!</h3>
        <p>This page is only accessible to Admin and SuperAdmin users.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h4>Admin Dashboard</h4>
        </div>
        <div class="card-body">
            <p>You have successfully accessed an admin-only page.</p>
            <p>Your role: <strong>@context.User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private AuthenticationState? context;

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask != null)
        {
            context = await authenticationStateTask;
        }
    }
}

