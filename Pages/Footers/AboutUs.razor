@page "/about"
@page "/about-us"

<PageTitle>About Us - Railway Ticket Booking</PageTitle>

<!-- Main Container with vibrant gradient background -->
<div class="user-management-container min-vh-100">
    <div class="container py-5">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto;">
                        <i class="fas fa-building fa-2x"></i>
                    </div>
                </div>
                <div class="col-md-8 text-center">
                    <h1 class="page-title mb-2" style="font-size: 2.5rem;">ABOUT US</h1>
                    <p class="mb-0 text-white opacity-75 text-uppercase small" style="letter-spacing: 4px; font-weight: 500;">Your Trusted Railway Booking Partner</p>
                </div>
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-train fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mission Section -->
        <div class="user-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h3 class="user-name mb-3" style="color: #4facfe;">
                        <i class="fas fa-bullseye me-2"></i>Our Mission
                    </h3>
                    <p class="text-white opacity-75" style="line-height: 1.8; font-size: 1.1rem;">
                        To make rail travel simple, convenient, and enjoyable for millions of travelers across the nation. 
                        We are committed to providing a seamless booking experience with cutting-edge technology, 
                        exceptional customer service, and transparent policies.
                    </p>
                </div>
                <div class="col-md-6 text-center">
                    <div class="user-avatar mx-auto" style="width: 200px; height: 200px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                        <i class="fas fa-rocket fa-4x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vision Section -->
        <div class="user-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center order-md-2">
                    <div class="user-avatar mx-auto" style="width: 200px; height: 200px; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                        <i class="fas fa-eye fa-4x"></i>
                    </div>
                </div>
                <div class="col-md-6 order-md-1">
                    <h3 class="user-name mb-3" style="color: #4facfe;">
                        <i class="fas fa-lightbulb me-2"></i>Our Vision
                    </h3>
                    <p class="text-white opacity-75" style="line-height: 1.8; font-size: 1.1rem;">
                        To become India's most trusted and innovative railway booking platform, empowering travelers 
                        with easy access to train tickets, real-time information, and exceptional travel experiences. 
                        We envision a future where booking train tickets is as simple as a few clicks.
                    </p>
                </div>
            </div>
        </div>

        <!-- Values Section -->
        <div class="user-card mb-4">
            <h3 class="user-name mb-4 text-center" style="color: #4facfe;">
                <i class="fas fa-heart me-2"></i>Our Core Values
            </h3>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <div class="user-avatar mx-auto mb-3" style="width: 80px; height: 80px; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <i class="fas fa-shield-alt fa-2x"></i>
                        </div>
                        <h5 class="text-white mb-3">Trust & Security</h5>
                        <p class="text-white opacity-75">Your data and transactions are protected with industry-leading security measures.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <div class="user-avatar mx-auto mb-3" style="width: 80px; height: 80px; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                        <h5 class="text-white mb-3">Customer First</h5>
                        <p class="text-white opacity-75">Your satisfaction is our priority. We're here to help you every step of the way.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <div class="user-avatar mx-auto mb-3" style="width: 80px; height: 80px; background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                            <i class="fas fa-cogs fa-2x"></i>
                        </div>
                        <h5 class="text-white mb-3">Innovation</h5>
                        <p class="text-white opacity-75">We continuously improve our platform with the latest technology and features.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Section -->
        <div class="user-card mb-4">
            <h3 class="user-name mb-4 text-center" style="color: #4facfe;">
                <i class="fas fa-chart-line me-2"></i>Our Impact
            </h3>
            <div class="row g-4">
                <div class="col-md-3 col-6">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <h2 class="text-white mb-2" style="font-size: 3rem; font-weight: 700;">10M+</h2>
                        <p class="text-white opacity-75 mb-0">Happy Customers</p>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <h2 class="text-white mb-2" style="font-size: 3rem; font-weight: 700;">50M+</h2>
                        <p class="text-white opacity-75 mb-0">Tickets Booked</p>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <h2 class="text-white mb-2" style="font-size: 3rem; font-weight: 700;">500+</h2>
                        <p class="text-white opacity-75 mb-0">Trains Available</p>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-center p-4" style="background: rgba(255, 255, 255, 0.1); border-radius: 15px;">
                        <h2 class="text-white mb-2" style="font-size: 3rem; font-weight: 700;">24/7</h2>
                        <p class="text-white opacity-75 mb-0">Support Available</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Section -->
        <div class="user-card mb-4">
            <h3 class="user-name mb-4 text-center" style="color: #4facfe;">
                <i class="fas fa-users-cog me-2"></i>Our Team
            </h3>
            <p class="text-white opacity-75 text-center mb-4" style="font-size: 1.1rem; line-height: 1.8;">
                We are a passionate team of developers, designers, customer support specialists, and travel enthusiasts 
                dedicated to making your railway booking experience seamless and enjoyable. Our diverse team brings together 
                expertise in technology, customer service, and the travel industry.
            </p>
            <div class="text-center">
                <a href="/careers" class="add-user-btn text-decoration-none">
                    <i class="fas fa-briefcase me-2"></i>Join Our Team
                </a>
            </div>
        </div>

        <!-- Contact CTA -->
        <div class="user-card text-center">
            <h3 class="user-name mb-3" style="color: #4facfe;">
                <i class="fas fa-envelope me-2"></i>Get in Touch
            </h3>
            <p class="text-white opacity-75 mb-4" style="font-size: 1.1rem;">
                Have questions or want to learn more? We'd love to hear from you!
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/contact" class="add-user-btn text-decoration-none">
                    <i class="fas fa-paper-plane me-2"></i>Contact Us
                </a>
                <a href="/faq" class="add-user-btn text-decoration-none" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-question-circle me-2"></i>View FAQs
                </a>
            </div>
        </div>
    </div>
</div>

