@page "/faq"
@page "/faqs"

<PageTitle>Frequently Asked Questions - Railway Ticket Booking</PageTitle>

<!-- Main Container with vibrant gradient background -->
<div class="user-management-container min-vh-100">
    <div class="container py-5">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto;">
                        <i class="fas fa-question-circle fa-2x"></i>
                    </div>
                </div>
                <div class="col-md-8 text-center">
                    <h1 class="page-title mb-2" style="font-size: 2.5rem;">FREQUENTLY ASKED QUESTIONS</h1>
                    <p class="mb-0 text-white opacity-75 text-uppercase small" style="letter-spacing: 4px; font-weight: 500;">Find Answers to Common Queries</p>
                </div>
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-lightbulb fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search FAQ Section -->
        <div class="user-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-10">
                    <input type="text" class="form-control form-control-lg" placeholder="Search for questions..." @bind="searchQuery" @bind:event="oninput" />
                </div>
                <div class="col-md-2 text-end">
                    <button class="add-user-btn w-100" @onclick="ClearSearch">
                        <i class="fas fa-times me-2"></i>Clear
                    </button>
                </div>
            </div>
        </div>

        <!-- FAQ Categories -->
        <div class="row g-4">
            @foreach (var category in GetFilteredCategories())
            {
                <div class="col-12">
                    <div class="user-card">
                        <h3 class="user-name mb-4" style="color: #ff6b9d; font-size: 1.5rem;">
                            <i class="fas @category.Icon me-2"></i>@category.Title
                        </h3>
                        <div class="accordion accordion-flush" id="accordion-@category.Id">
                            @foreach (var faq in category.FAQs)
                            {
                                var faqId = $"faq-{category.Id}-{faq.Id}";
                                <div class="accordion-item mb-3" style="background: rgba(255, 255, 255, 0.1); border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2);">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@faqId" aria-expanded="false" aria-controls="@faqId" style="background: rgba(255, 255, 255, 0.1); color: white; font-weight: 600;">
                                            <i class="fas fa-circle-question me-2" style="color: #4facfe;"></i>@faq.Question
                                        </button>
                                    </h2>
                                    <div id="@faqId" class="accordion-collapse collapse" data-bs-parent="#accordion-@category.Id">
                                        <div class="accordion-body" style="color: rgba(255, 255, 255, 0.9); line-height: 1.8;">
                                            @if (!string.IsNullOrEmpty(faq.Answer))
                                            {
                                                <p>@faq.Answer</p>
                                            }
                                            @if (faq.Steps != null && faq.Steps.Any())
                                            {
                                                <ol class="mt-3">
                                                    @foreach (var step in faq.Steps)
                                                    {
                                                        <li class="mb-2">@step</li>
                                                    }
                                                </ol>
                                            }
                                            @if (faq.Links != null && faq.Links.Any())
                                            {
                                                <div class="mt-3">
                                                    @foreach (var link in faq.Links)
                                                    {
                                                        <a href="@link.Url" target="_blank" class="btn btn-sm add-user-btn me-2 mb-2">
                                                            <i class="@link.Icon me-1"></i>@link.Text
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Still Need Help Section -->
        <div class="user-card mt-4 text-center">
            <h3 class="user-name mb-3">
                <i class="fas fa-headset me-2" style="color: #4facfe;"></i>Still Need Help?
            </h3>
            <p class="text-white opacity-75 mb-4">Can't find what you're looking for? Our support team is here to help!</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/contact" class="add-user-btn text-decoration-none">
                    <i class="fas fa-envelope me-2"></i>Contact Us
                </a>
                <a href="/help" class="add-user-btn text-decoration-none" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-life-ring me-2"></i>Get Help
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private string searchQuery = string.Empty;

    private List<FAQCategory> GetFilteredCategories()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return faqCategories;
        }

        var query = searchQuery.ToLower();
        return faqCategories.Select(category => new FAQCategory
        {
            Id = category.Id,
            Title = category.Title,
            Icon = category.Icon,
            FAQs = category.FAQs.Where(faq =>
                faq.Question.ToLower().Contains(query) ||
                faq.Answer.ToLower().Contains(query) ||
                (faq.Steps != null && faq.Steps.Any(s => s.ToLower().Contains(query)))
            ).ToList()
        }).Where(c => c.FAQs.Any()).ToList();
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
    }

