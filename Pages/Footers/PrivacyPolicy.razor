@page "/privacy"
@page "/privacy-policy"

<PageTitle>Privacy Policy - Railway Ticket Booking</PageTitle>

<!-- Main Container with vibrant gradient background -->
<div class="user-management-container min-vh-100">
    <div class="container py-5">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto;">
                        <i class="fas fa-shield-alt fa-2x"></i>
                    </div>
                </div>
                <div class="col-md-8 text-center">
                    <h1 class="page-title mb-2" style="font-size: 2.5rem;">PRIVACY POLICY</h1>
                    <p class="mb-0 text-white opacity-75 text-uppercase small" style="letter-spacing: 4px; font-weight: 500;">Your Privacy Matters to Us</p>
                </div>
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-lock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Last Updated -->
        <div class="user-card mb-4 text-center">
            <p class="text-white opacity-75 mb-0">
                <i class="fas fa-calendar-alt me-2" style="color: #4facfe;"></i>
                <strong>Last Updated:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")
            </p>
        </div>

        <!-- Privacy Policy Content -->
        <div class="user-card mb-4">
            @foreach (var section in privacySections)
            {
                <div class="mb-5">
                    <h3 class="user-name mb-3" style="color: #4facfe;">
                        <i class="@(section.Icon) me-2"></i>@(section.Title)
                    </h3>
                    <div class="text-white opacity-75" style="line-height: 1.8; font-size: 1.05rem;">
                        @if (section.Content != null)
                        {
                            @foreach (var paragraph in section.Content)
                            {
                                <p class="mb-3">@paragraph</p>
                            }
                        }
                        @if (section.ListItems != null && section.ListItems.Any())
                        {
                            <ul class="mb-3" style="padding-left: 1.5rem;">
                                @foreach (var item in section.ListItems)
                                {
                                    <li class="mb-2">@item</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Contact for Privacy -->
        <div class="user-card text-center">
            <h3 class="user-name mb-3" style="color: #4facfe;">
                <i class="fas fa-envelope me-2"></i>Privacy Questions?
            </h3>
            <p class="text-white opacity-75 mb-4" style="font-size: 1.1rem;">
                If you have any questions about this Privacy Policy or our data practices, please contact us.
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/contact" class="add-user-btn text-decoration-none">
                    <i class="fas fa-paper-plane me-2"></i>Contact Us
                </a>
                <a href="mailto:privacy@railblazer.com" class="add-user-btn text-decoration-none" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-envelope me-2"></i>privacy@railblazer.com
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PrivacySection> privacySections = new()
    {
        new PrivacySection
        {
            Title = "1. Introduction",
            Icon = "fas fa-info-circle",
            Content = new List<string>
            {
                "Welcome to RailBlazer. We are committed to protecting your privacy and ensuring the security of your personal information. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our railway ticket booking platform.",
                "By using our services, you agree to the collection and use of information in accordance with this policy. If you do not agree with our policies and practices, please do not use our services."
            }
        },
        new PrivacySection
        {
            Title = "2. Information We Collect",
            Icon = "fas fa-database",
            Content = new List<string>
            {
                "We collect several types of information from and about users of our platform:"
            },
            ListItems = new List<string>
            {
                "Personal Information: Name, email address, phone number, date of birth, gender, and identification documents",
                "Booking Information: Travel details, passenger information, payment details, and booking history",
                "Account Information: Username, password, profile preferences, and account settings",
                "Technical Information: IP address, browser type, device information, and usage data",
                "Location Information: When you use location-based features of our services"
            }
        },
        new PrivacySection
        {
            Title = "3. How We Use Your Information",
            Icon = "fas fa-cogs",
            Content = new List<string>
            {
                "We use the information we collect for various purposes:"
            },
            ListItems = new List<string>
            {
                "To process and manage your ticket bookings and reservations",
                "To communicate with you about your bookings, account, and our services",
                "To provide customer support and respond to your inquiries",
                "To improve our services, develop new features, and conduct research",
                "To send you promotional materials, newsletters, and updates (with your consent)",
                "To detect, prevent, and address technical issues and fraud",
                "To comply with legal obligations and enforce our terms of service"
            }
        },
        new PrivacySection
        {
            Title = "4. Information Sharing and Disclosure",
            Icon = "fas fa-share-alt",
            Content = new List<string>
            {
                "We do not sell your personal information. We may share your information in the following circumstances:"
            },
            ListItems = new List<string>
            {
                "With Indian Railways and service providers necessary to complete your booking",
                "With payment processors to facilitate transactions",
                "With law enforcement or government authorities when required by law",
                "In connection with a business transfer, merger, or acquisition",
                "With your explicit consent for any other purpose"
            }
        },
        new PrivacySection
        {
            Title = "5. Data Security",
            Icon = "fas fa-lock",
            Content = new List<string>
            {
                "We implement appropriate technical and organizational security measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. These measures include:",
                "However, no method of transmission over the Internet or electronic storage is 100% secure. While we strive to use commercially acceptable means to protect your information, we cannot guarantee absolute security."
            },
            ListItems = new List<string>
            {
                "Encryption of sensitive data during transmission (SSL/TLS)",
                "Secure storage of personal information",
                "Regular security assessments and updates",
                "Access controls and authentication mechanisms",
                "Employee training on data protection"
            }
        },
        new PrivacySection
        {
            Title = "6. Your Rights and Choices",
            Icon = "fas fa-user-shield",
            Content = new List<string>
            {
                "You have certain rights regarding your personal information:"
            },
            ListItems = new List<string>
            {
                "Access: Request access to your personal information",
                "Correction: Request correction of inaccurate or incomplete information",
                "Deletion: Request deletion of your personal information (subject to legal requirements)",
                "Objection: Object to processing of your personal information",
                "Data Portability: Request transfer of your data to another service",
                "Withdraw Consent: Withdraw consent for data processing where applicable"
            }
        },
        new PrivacySection
        {
            Title = "7. Cookies and Tracking Technologies",
            Icon = "fas fa-cookie",
            Content = new List<string>
            {
                "We use cookies and similar tracking technologies to track activity on our platform and store certain information. Cookies are files with a small amount of data that are sent to your browser from a website and stored on your device.",
                "You can instruct your browser to refuse all cookies or to indicate when a cookie is being sent. However, if you do not accept cookies, you may not be able to use some portions of our service."
            }
        },
        new PrivacySection
        {
            Title = "8. Third-Party Links",
            Icon = "fas fa-external-link-alt",
            Content = new List<string>
            {
                "Our platform may contain links to third-party websites or services. We are not responsible for the privacy practices of these external sites. We encourage you to review the privacy policies of any third-party sites you visit."
            }
        },
        new PrivacySection
        {
            Title = "9. Children's Privacy",
            Icon = "fas fa-child",
            Content = new List<string>
            {
                "Our services are not intended for children under the age of 18. We do not knowingly collect personal information from children. If you are a parent or guardian and believe your child has provided us with personal information, please contact us immediately."
            }
        },
        new PrivacySection
        {
            Title = "10. Changes to This Privacy Policy",
            Icon = "fas fa-edit",
            Content = new List<string>
            {
                "We may update our Privacy Policy from time to time. We will notify you of any changes by posting the new Privacy Policy on this page and updating the 'Last Updated' date.",
                "You are advised to review this Privacy Policy periodically for any changes. Changes to this Privacy Policy are effective when they are posted on this page."
            }
        }
    };

    private class PrivacySection
    {
        public string Title { get; set; }
        public string Icon { get; set; }
        public List<string> Content { get; set; }
        public List<string> ListItems { get; set; }
    }
}
