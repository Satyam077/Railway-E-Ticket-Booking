@page "/terms"
@page "/terms-of-service"

<PageTitle>Terms of Service - Railway Ticket Booking</PageTitle>

<!-- Main Container with vibrant gradient background -->
<div class="user-management-container min-vh-100">
    <div class="container py-5">
        <!-- Page Header -->
        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto;">
                        <i class="fas fa-file-contract fa-2x"></i>
                    </div>
                </div>
                <div class="col-md-8 text-center">
                    <h1 class="page-title mb-2" style="font-size: 2.5rem;">TERMS OF SERVICE</h1>
                    <p class="mb-0 text-white opacity-75 text-uppercase small" style="letter-spacing: 4px; font-weight: 500;">Please Read Carefully</p>
                </div>
                <div class="col-md-2 text-center">
                    <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-gavel fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Last Updated -->
        <div class="user-card mb-4 text-center">
            <p class="text-white opacity-75 mb-0">
                <i class="fas fa-calendar-alt me-2" style="color: #4facfe;"></i>
                <strong>Last Updated:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")
            </p>
        </div>

        <!-- Terms Content -->
        <div class="user-card mb-4">
            @foreach (var section in termsSections)
            {
                <div class="mb-5">
                    <h3 class="user-name mb-3" style="color: #4facfe;">
                        <i class="@(section.Icon) me-2"></i>@(section.Title)
                    </h3>
                    <div class="text-white opacity-75" style="line-height: 1.8; font-size: 1.05rem;">
                        @if (section.Content != null)
                        {
                            @foreach (var paragraph in section.Content)
                            {
                                <p class="mb-3">@paragraph</p>
                            }
                        }
                        @if (section.ListItems != null && section.ListItems.Any())
                        {
                            <ul class="mb-3" style="padding-left: 1.5rem;">
                                @foreach (var item in section.ListItems)
                                {
                                    <li class="mb-2">@item</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Acceptance -->
        <div class="user-card text-center">
            <h3 class="user-name mb-3" style="color: #4facfe;">
                <i class="fas fa-check-circle me-2"></i>Acceptance of Terms
            </h3>
            <p class="text-white opacity-75 mb-4" style="font-size: 1.1rem;">
                By accessing and using RailBlazer's services, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service.
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/contact" class="add-user-btn text-decoration-none">
                    <i class="fas fa-question-circle me-2"></i>Questions About Terms?
                </a>
                <a href="/privacy" class="add-user-btn text-decoration-none" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <i class="fas fa-shield-alt me-2"></i>Privacy Policy
                </a>
            </div>
        </div>
    </div>
</div>

@code {
