@page "/booking-confirmation/{BookingId}"

@using Railway_Ticket_Booking.Infrastructure
@using MongoDB.Driver
@using Railway_Ticket_Booking.Domain.Entities
@inject MongoDbContext Db
@inject NavigationManager Nav

<PageTitle>Booking Confirmed</PageTitle>

@if (loading)
{
    <div class="text-center mt-5">
        <h3>Loading your booking...</h3>
    </div>
}
else if (error != null)
{
    <div class="alert alert-danger mt-4">
        <h4>Booking Not Found</h4>
        <p>@error</p>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="alert alert-success">
            <h3 class="fw-bold">🎉 Payment Successful!</h3>
            <p>Your ticket has been booked successfully.</p>
        </div>

        <div class="card p-4 shadow-sm">
            <h4 class="fw-bold">Booking Details</h4>
            <hr />

            <p><strong>Booking ID:</strong> @booking.Id</p>
            <p><strong>PNR:</strong> @booking.PNR</p>
            <p><strong>Status:</strong> @booking.Status</p>
            <p><strong>Amount Paid:</strong> ₹@booking.FinalAmount</p>

            @if (payment != null)
            {
                <h5 class="mt-4 fw-bold">Payment Details</h5>
                <p><strong>Transaction ID:</strong> @payment.TransactionId</p>
                <p><strong>Gateway:</strong> @payment.GatewayName</p>
                <p><strong>Status:</strong> @payment.Status</p>
            }
        </div>

        <div class="mt-4">
            <button class="btn btn-primary" @onclick="GoToHome">Go to Home</button>
        </div>
    </div>
}

@code {
    [Parameter]
    public string BookingId { get; set; }
    Railway_Ticket_Booking.Domain.Entities.Booking booking { get; set; }
    Railway_Ticket_Booking.Domain.Entities.Payment payment { get; set; }


    bool loading = true;
    string error = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(BookingId))
            {
                error = "Invalid booking ID.";
                loading = false;
                return;
            }

            // Find booking
            booking = await Db.Bookings
                .Find(b => b.Id == BookingId)
                .FirstOrDefaultAsync();

            if (booking == null)
            {
                error = "No booking found with this ID.";
                loading = false;
                return;
            }

            // Find payment linked to booking
            if (!string.IsNullOrEmpty(booking.PaymentId))
            {
                var payment = await Db.Payments
                    .Find(p => p.Id == booking.PaymentId)
                    .FirstOrDefaultAsync();
            }
            else
            {
                // Try to find payment by booking ID
                var payment = await Db.Payments
                    .Find(p => p.BookingId == booking.Id)
                    .FirstOrDefaultAsync();
            }
        }
        catch (Exception ex)
        {
            error = $"Error loading booking: {ex.Message}";
            Console.WriteLine($"BookingConfirmation Error: {ex}");
        }
        finally
        {
            loading = false;
        }
    }

    void GoToHome()
    {
        Nav.NavigateTo("/");
    }
}
