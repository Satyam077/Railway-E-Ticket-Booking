@page "/cancel-booking/{BookingId}"
@using MediatR
@using Railway_Ticket_Booking.Application.Bookings.Commands
@using Railway_Ticket_Booking.Domain.Entities
@using Railway_Ticket_Booking.Domain.Enums
@using Railway_Ticket_Booking.Infrastructure
@using Railway_Ticket_Booking.Infrastructure.Services
@using MongoDB.Driver
@inject IMediator Mediator
@inject MongoDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject CancellationService CancellationService

<PageTitle>Cancel Booking - @(booking?.PNR ?? "Loading...")</PageTitle>

@if (loading)
{
    <div class="container my-5">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="mt-4 text-muted">Loading booking details...</h4>
        </div>
    </div>
}
else if (error != null)
{
    <div class="container my-5">
        <div class="alert alert-danger shadow-sm">
            <h4><i class="fas fa-exclamation-triangle me-2"></i>Error</h4>
            <p class="mb-0">@error</p>
        </div>
        <div class="text-center mt-4">
            <button class="btn btn-primary" @onclick="GoBack">Go Back</button>
        </div>
    </div>
}
else if (booking != null)
{
    <div class="container my-5">
        <!-- Warning Header -->
        <div class="alert alert-warning border-0 shadow-sm mb-4">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-warning"></i>
                </div>
                <div class="flex-grow-1">
                    <h3 class="mb-1 fw-bold">Cancel Booking</h3>
                    <p class="mb-0">PNR: <strong>@booking.PNR</strong></p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Booking Details -->
            <div class="col-lg-8">
                <!-- Booking Information -->
                <div class="card shadow-lg border-0 rounded-4 mb-4">
                    <div class="card-header bg-primary text-white rounded-top-4 py-3">
                        <h5 class="mb-0"><i class="fas fa-ticket-alt me-2"></i>Booking Information</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-muted d-block">PNR Number</small>
                                <h5 class="mb-0 fw-bold text-primary">@booking.PNR</h5>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Journey Date</small>
                                <strong>@booking.JourneyDate.ToString("dd MMM, yyyy HH:mm")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Passengers</small>
                                <strong>@booking.Passengers.Count</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block">Total Amount Paid</small>
                                <strong class="text-success">₹@booking.FinalAmount.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                @if (cancellationResult != null && cancellationResult.IsCancellable)
                {
                    <!-- Refund Calculation -->
                    <div class="card shadow-lg border-0 rounded-4 mb-4">
                        <div class="card-header bg-info text-white rounded-top-4 py-3">
                            <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Refund Calculation</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <small class="text-muted d-block mb-2">Cancellation Charges Policy</small>
                                <div class="alert alert-light">
                                    <small>@GetCancellationPolicyInfo()</small>
                                </div>
                            </div>
                            <hr />
                            <div class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">Base Fare</span>
                                <strong>₹@cancellationResult.BaseFare.ToString("N2")</strong>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">Cancellation Charges</span>
                                <strong class="text-danger">-₹@cancellationResult.CancellationCharge.ToString("N2")</strong>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">Tax (Not Refundable)</span>
                                <strong class="text-muted">₹@cancellationResult.TaxAmount.ToString("N2")</strong>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <span class="text-muted">Service Charge (Not Refundable)</span>
                                <strong class="text-muted">₹@cancellationResult.ServiceCharge.ToString("N2")</strong>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Refund Amount</h5>
                                <h4 class="mb-0 text-success fw-bold">₹@cancellationResult.RefundAmount.ToString("N2")</h4>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Refund will be processed within @cancellationResult.ProcessingDays business days.
                                </small>
                            </div>
                        </div>
                    </div>
                }
                else if (cancellationResult != null && !cancellationResult.IsCancellable)
                {
                    <!-- Cannot Cancel -->
                    <div class="card shadow-lg border-0 rounded-4 mb-4">
                        <div class="card-header bg-danger text-white rounded-top-4 py-3">
                            <h5 class="mb-0"><i class="fas fa-ban me-2"></i>Cancellation Not Allowed</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-danger">
                                <strong>@cancellationResult.Reason</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column: Cancellation Form -->
            <div class="col-lg-4">
                @if (cancellationResult != null && cancellationResult.IsCancellable)
                {
                    <div class="card shadow-lg border-0 rounded-4 mb-4">
                        <div class="card-header bg-danger text-white rounded-top-4 py-3">
                            <h5 class="mb-0"><i class="fas fa-times-circle me-2"></i>Confirm Cancellation</h5>
                        </div>
                        <div class="card-body p-4">
                            <EditForm Model="@cancelCommand" OnValidSubmit="HandleCancellation">
                                <DataAnnotationsValidator />
                                <ValidationSummary />

                                <div class="mb-3">
                                    <label class="form-label">Reason for Cancellation (Optional)</label>
                                    <InputTextArea class="form-control" rows="3" @bind-Value="cancelCommand.CancellationReason" placeholder="Enter reason for cancellation..." />
                                </div>

                                <div class="alert alert-warning">
                                    <small>
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        <strong>Warning:</strong> This action cannot be undone. Your booking will be cancelled and refund will be processed.
                                    </small>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-danger btn-lg" disabled="@isCancelling">
                                        @if (isCancelling)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-times-circle me-2"></i>Confirm Cancellation
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="GoBack" disabled="@isCancelling">
                                        <i class="fas fa-arrow-left me-2"></i>Go Back
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-lg border-0 rounded-4 mb-4">
                        <div class="card-body p-4 text-center">
                            <button class="btn btn-primary" @onclick="GoBack">
                                <i class="fas fa-arrow-left me-2"></i>Go Back
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string BookingId { get; set; }

    public Railway_Ticket_Booking.Domain.Entities.Booking booking { get; set; }
    private CancellationResult cancellationResult { get; set; }
    private CancelBookingCommand cancelCommand = new CancelBookingCommand();
    private bool loading = true;
    private bool isCancelling = false;
    private string error = null;
    private string userId = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(BookingId))
            {
                error = "Invalid booking ID.";
                loading = false;
                return;
            }

            // Get user ID from localStorage
            userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (string.IsNullOrEmpty(userId))
            {
                Nav.NavigateTo($"/login?returnUrl=/cancel-booking/{BookingId}");
                return;
            }

            // Load booking
            booking = await Db.Bookings
                .Find(b => b.Id == BookingId)
                .FirstOrDefaultAsync();

            if (booking == null)
            {
                error = "Booking not found.";
                loading = false;
                return;
            }

            // Verify user owns the booking
            if (booking.UserId != userId)
            {
                error = "You are not authorized to cancel this booking.";
                loading = false;
                return;
            }

            // Check if already cancelled
            if (booking.Status == BookingStatus.Cancelled)
            {
                error = "This booking has already been cancelled.";
                loading = false;
                return;
            }

            // Calculate cancellation and refund
            cancellationResult = CancellationService.CalculateRefund(booking, DateTime.UtcNow);

            // Initialize cancel command
            cancelCommand.BookingId = BookingId;
            cancelCommand.UserId = userId;
        }
        catch (Exception ex)
        {
            error = $"Error loading booking: {ex.Message}";
            Console.WriteLine($"CancelBooking Error: {ex}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleCancellation()
    {
        isCancelling = true;
        try
        {
            var result = await Mediator.Send(cancelCommand);

            if (result.Success)
            {
                await JSRuntime.InvokeVoidAsync("alert", 
                    $"Booking cancelled successfully!\n\n" +
                    $"Refund Amount: ₹{result.RefundAmount:N2}\n" +
                    $"Processing Time: {result.ProcessingDays} business days\n\n" +
                    $"Refund Transaction ID: {result.RefundTransactionId}");

                // Navigate to cancellation confirmation or booking list
                Nav.NavigateTo($"/booking-confirmation/{BookingId}");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error cancelling booking: {ex.Message}");
        }
        finally
        {
            isCancelling = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo($"/booking-confirmation/{BookingId}");
    }

    private string GetCancellationPolicyInfo()
    {
        if (booking == null || cancellationResult == null)
            return "";

        var departureTime = booking.JourneyDate;
        var timeBeforeDeparture = departureTime - DateTime.Now;
        var hoursBeforeDeparture = timeBeforeDeparture.TotalHours;

        if (hoursBeforeDeparture > 48)
        {
            return "More than 48 hours before departure: Flat cancellation charges apply based on class. Full refund after charges.";
        }
        else if (hoursBeforeDeparture > 12)
        {
            return "Between 48 and 12 hours before departure: 25% of fare deducted (minimum cancellation charge applies). Full refund after charges.";
        }
        else if (hoursBeforeDeparture > 4)
        {
            return "Between 12 and 4 hours before departure: 50% of fare deducted (minimum cancellation charge applies). Full refund after charges.";
        }

        return "Cancellation not allowed less than 4 hours before departure.";
    }
}

