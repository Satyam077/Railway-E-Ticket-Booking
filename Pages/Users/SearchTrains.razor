@page "/"
@using MediatR
@using Railway_Ticket_Booking.Application.TrainSchedules.Queries
@using Railway_Ticket_Booking.Application.Routes.Queries
@using Railway_Ticket_Booking.Domain.Entities
@using System.Text.Json
@inject IMediator Mediator
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<!-- Main Container with vibrant gradient background matching design system -->
<div class="user-management-container min-vh-100">
    
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto;">
                    <i class="fas fa-train fa-2x"></i>
                </div>
            </div>
            <div class="col-md-8 text-center">
                <h1 class="page-title mb-2" style="font-size: 2.5rem;">INDIAN RAILWAYS</h1>
                <p class="mb-0 text-white opacity-75 text-uppercase small" style="letter-spacing: 4px; font-weight: 500;">Safety | Security | Punctuality</p>
            </div>
            <div class="col-md-2 text-center">
                <div class="user-avatar" style="width: 80px; height: 80px; margin: 0 auto; background: linear-gradient(135deg, #4facfe, #00f2fe);">
                    <i class="fas fa-ticket-alt fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="stats-container mb-4">
        <div class="stat-item" style="cursor: pointer;">
            <span class="stat-label"><i class="fas fa-search me-2"></i>PNR STATUS</span>
        </div>
        <div class="stat-item" style="cursor: pointer;">
            <span class="stat-label"><i class="fas fa-chart-bar me-2"></i>CHARTS / VACANCY</span>
        </div>
        <div class="stat-item" style="cursor: pointer;" @onclick="NavigateLogin">
            <span class="stat-label"><i class="fas fa-sign-in-alt me-2"></i>LOGIN</span>
        </div>
    </div>

    <!-- Search Form Section -->
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="user-card">
                    <h2 class="user-name text-center mb-4">
                        <i class="fas fa-ticket-alt me-2" style="color: #f093fb;"></i>
                        Book Your Ticket
                    </h2>
                    <hr class="border-white border-2 opacity-25 w-25 mx-auto mb-4" />
                    
                    <EditForm Model="searchQuery" OnValidSubmit="HandleSearchTrains">
                        <div class="row g-4">
                            <!-- From Station -->
                            <div class="col-md-6">
                                <label class="form-label-custom">
                                    <i class="fas fa-map-marker-alt me-2" style="color: #4facfe;"></i>FROM STATION
                                </label>
                                <InputSelect class="form-control form-control-custom form-control-lg" @bind-Value="searchQuery.FromStationId">
                                    <option value="">Select Station</option>
                                    @foreach (var station in stations)
                                    {
                                        <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                    }
                                </InputSelect>
                            </div>

                            <!-- Date -->
                            <div class="col-md-6">
                                <label class="form-label-custom">
                                    <i class="fas fa-calendar me-2" style="color: #43e97b;"></i>TRAVEL DATE
                                </label>
                                <InputDate class="form-control form-control-custom form-control-lg" @bind-Value="searchQuery.TravelDate" />
                            </div>

                            <!-- Swap Button -->
                            <div class="col-12 text-center my-2">
                                <button type="button" class="btn rounded-circle p-3 shadow-lg" style="width: 60px; height: 60px; background: linear-gradient(135deg, #ffd89b, #19547b); border: none; transition: all 0.3s ease;" @onclick="SwapStations">
                                    <i class="fas fa-exchange-alt fs-5 text-white"></i>
                                </button>
                            </div>

                            <!-- To Station -->
                            <div class="col-md-6">
                                <label class="form-label-custom">
                                    <i class="fas fa-map-marker-alt me-2" style="color: #f5576c;"></i>TO STATION
                                </label>
                                <InputSelect class="form-control form-control-custom form-control-lg" @bind-Value="searchQuery.ToStationId">
                                    <option value="">Select Station</option>
                                    @foreach (var station in stations)
                                    {
                                        <option value="@station.Id">@station.StationName (@station.StationCode)</option>
                                    }
                                </InputSelect>
                            </div>

                            <!-- Class Selection -->
                            <div class="col-md-6">
                                <label class="form-label-custom">
                                    <i class="fas fa-couch me-2" style="color: #f093fb;"></i>CLASS
                                </label>
                                <InputSelect class="form-control form-control-custom form-control-lg" @bind-Value="searchQuery.Class">
                                    <option value="All Classes">All Classes</option>
                                    <option value="AC First Class">AC First Class (1A)</option>
                                    <option value="AC 2 Tier">AC 2 Tier (2A)</option>
                                    <option value="AC 3 Tier">AC 3 Tier (3A)</option>
                                    <option value="Sleeper">Sleeper (SL)</option>
                                    <option value="Second Sitting">Second Sitting (2S)</option>
                                    <option value="Chair Car">Chair Car (CC)</option>
                                </InputSelect>
                            </div>

                            <!-- Quota Selection -->
                            <div class="col-md-12">
                                <label class="form-label-custom">
                                    <i class="fas fa-layer-group me-2" style="color: #4facfe;"></i>QUOTA
                                </label>
                                <InputSelect class="form-control form-control-custom form-control-lg" style="max-width: 300px;" @bind-Value="searchQuery.Quota">
                                    <option value="GENERAL">GENERAL</option>
                                    <option value="LADIES">LADIES</option>
                                    <option value="SENIOR CITIZEN">SENIOR CITIZEN</option>
                                    <option value="TATKAL">TATKAL</option>
                                    <option value="PREMIUM TATKAL">PREMIUM TATKAL</option>
                                </InputSelect>
                            </div>

                            <!-- Checkboxes -->
                            <div class="col-12">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-check p-3 rounded-3" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                                            <InputCheckbox class="form-check-input" id="disability" @bind-Value="searchQuery.PersonWithDisability" />
                                            <label class="form-check-label text-white fw-semibold" for="disability">Person With Disability</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-3 rounded-3" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                                            <InputCheckbox class="form-check-input" id="flexible" @bind-Value="searchQuery.FlexibleWithDate" />
                                            <label class="form-check-label text-white fw-semibold" for="flexible">Flexible With Date</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-3 rounded-3" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                                            <InputCheckbox class="form-check-input" id="berth" @bind-Value="searchQuery.TrainWithAvailableBerth" />
                                            <label class="form-check-label text-white fw-semibold" for="berth">Available Berth</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-3 rounded-3" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                                            <InputCheckbox class="form-check-input" id="pass" @bind-Value="searchQuery.RailwayPassConcession" />
                                            <label class="form-check-label text-white fw-semibold" for="pass">Railway Pass</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Search Buttons -->
                            <div class="col-12 mt-4">
                                <div class="d-flex flex-wrap gap-3 justify-content-center">
                                    <button type="submit" class="submit-btn px-5" disabled="@isSearching">
                                        @if (isSearching)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-search me-2"></i>Search Trains
                                    </button>
                                    <button type="button" class="add-user-btn px-4" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                                        <i class="fas fa-robot me-2"></i>Ask DISHA
                                    </button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Train Image/Badge Section -->
            <div class="col-lg-4">
                <div class="user-card text-center h-100 position-relative">
                    <div class="user-avatar mx-auto mb-4" style="width: 120px; height: 120px; background: linear-gradient(135deg, #4facfe, #00f2fe);">
                        <i class="fas fa-train fa-3x"></i>
                    </div>
                    <h5 class="user-name mb-3">Vande Bharat Express</h5>
                    <p class="text-white opacity-75">Experience the fastest trains in India</p>
                    <div class="position-absolute bottom-0 end-0 m-3">
                        <span class="meta-badge" style="background: linear-gradient(135deg, #4facfe, #00f2fe); font-size: 0.9rem;">
                <p class="text-white opacity-75 mb-3">@searchResults.Count trains found for <strong>@GetStationName(searchQuery.FromStationId)</strong> to <strong>@GetStationName(searchQuery.ToStationId)</strong></p>
                <span class="meta-badge" style="background: linear-gradient(135deg, #4facfe, #00f2fe); padding: 0.75rem 1.5rem;">
                    <i class="far fa-calendar-alt me-2"></i>@searchQuery.TravelDate.ToString("dd MMM, yyyy")
                </span>
            </div>

            @foreach (var train in searchResults)
            {
                <div class="user-card mb-4">
                    <div class="row align-items-center g-3">
                        <!-- Train Info -->
                        <div class="col-lg-3">
                            <h5 class="user-name mb-2">@train.TrainName</h5>
                            <span class="meta-badge mb-2 d-inline-block">#@train.TrainNumber</span>
                            <div class="mb-2">
                                <span class="meta-badge status-active text-uppercase small">@train.TrainType</span>
                            </div>
                            <div class="small text-white opacity-75">
                                <small>Runs: </small>
                                @foreach (var day in train.RunsOn.Take(7))
                                {
                                    <span class="badge rounded-circle me-1" style="width: 24px; height: 24px; font-size: 10px; line-height: 14px; background: linear-gradient(135deg, #43e97b, #38f9d7);">@day.Substring(0,1)</span>
                                }
                            </div>
                        </div>

                        <!-- Timing Info -->
                        <div class="col-lg-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-center">
                                    <div class="fs-4 fw-bold text-white">@train.DepartureTime.ToString("HH:mm")</div>
                                    <small class="text-white opacity-75 fw-semibold">@train.FromStationCode</small>
                                </div>
                                <div class="flex-grow-1 mx-3 text-center">
                                    <small class="text-white opacity-75 d-block mb-1">@FormatDuration(train.Duration)</small>
                                    <div class="border-top border-2 position-relative" style="border-color: rgba(255,255,255,0.5) !important;">
                                        <i class="fas fa-train position-absolute top-50 start-50 translate-middle px-2" style="background: linear-gradient(135deg, #667eea, #764ba2); color: white;"></i>
                                    </div>
                                </div>
                                <div class="text-center">
                                    <div class="fs-4 fw-bold text-white">@train.ArrivalTime.ToString("HH:mm")</div>
                                    <small class="text-white opacity-75 fw-semibold">@train.ToStationCode</small>
                                </div>
                            </div>
                        </div>

                        <!-- Available Classes -->
                        <div class="col-lg-3">
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var availableClass in train.Classes.Take(4))
                                {
                                    <span class="meta-badge">@availableClass.ClassName</span>
                                }
                                @if (train.Classes.Count > 4)
                                {
                                    <span class="meta-badge">+@(train.Classes.Count - 4) more</span>
                                }
                            </div>
                        </div>

                        <!-- Book Button -->
                        <div class="col-lg-2 text-center">
                            <button class="add-user-btn w-100" @onclick="() => BookTrain(train)">
                                <i class="fas fa-ticket-alt me-2"></i>Book
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (searchResults != null && !searchResults.Any())
    {
        <div class="container py-5">
            <div class="user-card text-center py-5">
                <i class="fas fa-train fa-5x mb-4" style="color: rgba(255,255,255,0.3);"></i>
                <h4 class="user-name mb-3">No Trains Found</h4>
                <p class="text-white opacity-75 mb-0">No trains available for the selected route and date. Please try different search criteria.</p>
            </div>
        </div>
    }
</div>

@code {
    private List<Station> stations = new List<Station>();
    private List<TrainSearchResult> searchResults = null;
    private SearchTrainsQuery searchQuery = new SearchTrainsQuery
    {
        TravelDate = DateTime.Today.AddDays(1),
        Class = "All Classes",
        Quota = "GENERAL"
    };
    private bool isSearching = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStations();
    }

    private async Task LoadStations()
    {
        try
        {
            var allStations = await Mediator.Send(new GetAllStationsQuery());
            stations = allStations;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stations: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error loading stations. Please refresh the page.");
        }
    }

    private async Task HandleSearchTrains()
    {
        if (string.IsNullOrEmpty(searchQuery.FromStationId) || string.IsNullOrEmpty(searchQuery.ToStationId))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select both From and To stations.");
            return;
        }

        if (searchQuery.FromStationId == searchQuery.ToStationId)
        {
            await JSRuntime.InvokeVoidAsync("alert", "From and To stations cannot be the same.");
            return;
        }

        isSearching = true;
        try
        {
            searchResults = await Mediator.Send(searchQuery);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching trains: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error searching trains: {ex.Message}");
            searchResults = new List<TrainSearchResult>();
        }
        finally
        {
            isSearching = false;
        }
    }

    private void SwapStations()
    {
        var temp = searchQuery.FromStationId;
        searchQuery.FromStationId = searchQuery.ToStationId;
        searchQuery.ToStationId = temp;
    }

    private string GetStationName(string stationId)
    {
        var station = stations.FirstOrDefault(s => s.Id == stationId);
        return station != null ? $"{station.StationName} ({station.StationCode})" : "Unknown";
    }

    private string FormatDuration(TimeSpan duration)
    {
        return $"{duration.Hours}h {duration.Minutes}m";
    }

    private async Task BookTrain(TrainSearchResult train)
    {
        var bookingData = new
        {
            TrainId = train.TrainId,
            ScheduleId = train.ScheduleId,
            TrainName = train.TrainName,
            TrainNumber = train.TrainNumber,
            FromStationId = searchQuery.FromStationId,
            ToStationId = searchQuery.ToStationId,
            FromStation = train.FromStation,
            ToStation = train.ToStation,
            FromStationCode = train.FromStationCode,
            ToStationCode = train.ToStationCode,
            TravelDate = searchQuery.TravelDate,
            DepartureTime = train.DepartureTime,
            ArrivalTime = train.ArrivalTime,
            Duration = train.Duration,
            Classes = train.Classes
        };

        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "bookingData", JsonSerializer.Serialize(bookingData));
        
        // Check if user is authenticated
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        
        if (string.IsNullOrEmpty(token))
        {
            // Store pending booking and redirect to login
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pendingBooking", "true");
            NavigationManager.NavigateTo("/login?returnUrl=/booking");
        }
        else
        {
            NavigationManager.NavigateTo("/booking");
        }
    }

    private void NavigateLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}