@page "/profile"
@using MediatR
@using RailwayTicketBooking.Application.Queries
@using RailwayTicketBooking.Domain.Entities
@using RailwayTicketBooking.Domain.Enums
@using RailwayTicketBooking.Infrastructure
@using MongoDB.Driver
@inject IMediator Mediator
@inject MongoDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>My Profile</PageTitle>

<div class="user-management-container min-vh-100">
    <div class="container py-5">
        @if (loading)
        {
            <div class="loading-container">
                <div class="spinner-custom"></div>
                <p class="mt-3 text-white fw-bold">Loading your profile...</p>
            </div>
        }
        else if (error != null)
        {
            <div class="alert-custom alert-danger-custom">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Error:</strong> @error
            </div>
            <div class="text-center mt-4">
                <button class="add-user-btn" @onclick="GoToHome">
                    <i class="fas fa-home me-2"></i>
                    Go to Home
                </button>
            </div>
        }
        else if (user != null)
        {
            <!-- Page Header -->
            <div class="page-header mb-4">
                <h1 class="page-title">
                    <i class="fas fa-user-circle me-2"></i>
                    My Profile
                </h1>
            </div>

            <!-- Profile Header Card -->
            <div class="user-card mb-4">
                <div class="d-flex align-items-center flex-wrap gap-4">
                    <div class="user-avatar" style="width: 100px; height: 100px; font-size: 2.5rem;">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h2 class="user-name mb-2">@user.FullName</h2>
                        <div class="mb-2">
                            <span class="meta-badge @GetRoleBadgeClass(user.Role) me-2">@GetRoleName(user.Role)</span>
                            @if (user.IsEmailVerified)
                            {
                                <span class="meta-badge status-active me-2"><i class="fas fa-check-circle me-1"></i>Email Verified</span>
                            }
                            @if (user.IsPhoneVerified)
                            {
                                <span class="meta-badge status-active"><i class="fas fa-check-circle me-1"></i>Phone Verified</span>
                            }
                        </div>
                        <p class="text-white opacity-75 mb-0">
                            <i class="fas fa-envelope me-2"></i>@user.Email
                        </p>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Personal Information -->
                <div class="col-lg-6">
                    <div class="user-card h-100">
                        <h5 class="user-name mb-4">
                            <i class="fas fa-user me-2" style="color: #4facfe;"></i>
                            Personal Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">First Name</small>
                                <strong class="text-white">@user.FirstName</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Last Name</small>
                                <strong class="text-white">@user.LastName</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Email</small>
                                <strong class="text-white">@user.Email</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Phone Number</small>
                                <strong class="text-white">@user.PhoneNumber</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Date of Birth</small>
                                <strong class="text-white">@user.DateOfBirth.ToString("dd MMM, yyyy")</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Age</small>
                                <strong class="text-white">@user.Age years</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Gender</small>
                                <strong class="text-white">@(string.IsNullOrEmpty(user.Gender) ? "Not specified" : user.Gender)</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Role</small>
                                <span class="meta-badge @GetRoleBadgeClass(user.Role)">@GetRoleName(user.Role)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Address Information -->
                <div class="col-lg-6">
                    <div class="user-card h-100">
                        <h5 class="user-name mb-4">
                            <i class="fas fa-map-marker-alt me-2" style="color: #43e97b;"></i>
                            Address Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <small class="text-white-50 d-block mb-1">Address</small>
                                <strong class="text-white">@(string.IsNullOrEmpty(user.Address) ? "Not provided" : user.Address)</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">City</small>
                                <strong class="text-white">@(string.IsNullOrEmpty(user.City) ? "Not provided" : user.City)</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">State</small>
                                <strong class="text-white">@(string.IsNullOrEmpty(user.State) ? "Not provided" : user.State)</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Pin Code</small>
                                <strong class="text-white">@(string.IsNullOrEmpty(user.PinCode) ? "Not provided" : user.PinCode)</strong>
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Country</small>
                                <strong class="text-white">@(string.IsNullOrEmpty(user.Country) ? "India" : user.Country)</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Account Information -->
                <div class="col-lg-6">
                    <div class="user-card h-100">
                        <h5 class="user-name mb-4">
                            <i class="fas fa-info-circle me-2" style="color: #f093fb;"></i>
                            Account Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Account Status</small>
                                @if (user.IsActive)
                                {
                                    <span class="meta-badge status-active">Active</span>
                                }
                                else
                                {
                                    <span class="meta-badge status-inactive">Inactive</span>
                                }
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Email Verification</small>
                                @if (user.IsEmailVerified)
                                {
                                    <span class="meta-badge status-active"><i class="fas fa-check me-1"></i>Verified</span>
                                }
                                else
                                {
                                    <span class="meta-badge" style="background: rgba(255, 193, 7, 0.8);"><i class="fas fa-times me-1"></i>Not Verified</span>
                                }
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Phone Verification</small>
                                @if (user.IsPhoneVerified)
                                {
                                    <span class="meta-badge status-active"><i class="fas fa-check me-1"></i>Verified</span>
                                }
                                else
                                {
                                    <span class="meta-badge" style="background: rgba(255, 193, 7, 0.8);"><i class="fas fa-times me-1"></i>Not Verified</span>
                                }
                            </div>
                            <div class="col-md-6">
                                <small class="text-white-50 d-block mb-1">Member Since</small>
                                <strong class="text-white">@user.CreatedAt.ToString("dd MMM, yyyy")</strong>
                            </div>
                            @if (user.LastLoginAt.HasValue)
                            {
                                <div class="col-md-6">
                                    <small class="text-white-50 d-block mb-1">Last Login</small>
                                    <strong class="text-white">@user.LastLoginAt.Value.ToString("dd MMM, yyyy HH:mm")</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Booking Statistics -->
                <div class="col-lg-6">
                    <div class="user-card h-100">
                        <h5 class="user-name mb-4">
                            <i class="fas fa-chart-bar me-2" style="color: #ffd89b;"></i>
                            Booking Statistics
                        </h5>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: rgba(255,255,255,0.1);">
                                    <div>
                                        <small class="text-white-50 d-block mb-1">Total Bookings</small>
                                        <h3 class="mb-0 fw-bold text-white">@totalBookings</h3>
                                    </div>
                                    <i class="fas fa-ticket-alt fa-3x" style="color: #4facfe; opacity: 0.5;"></i>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: rgba(255,255,255,0.1);">
                                    <div>
                                        <small class="text-white-50 d-block mb-1">Confirmed Bookings</small>
                                        <h3 class="mb-0 fw-bold text-white">@confirmedBookings</h3>
                                    </div>
                                    <i class="fas fa-check-circle fa-3x" style="color: #43e97b; opacity: 0.5;"></i>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: rgba(255,255,255,0.1);">
                                    <div>
                                        <small class="text-white-50 d-block mb-1">Cancelled Bookings</small>
                                        <h3 class="mb-0 fw-bold text-white">@cancelledBookings</h3>
                                    </div>
                                    <i class="fas fa-times-circle fa-3x" style="color: #f5576c; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-center mt-5">
                <a href="/" class="cancel-btn me-3 text-decoration-none d-inline-flex align-items-center">
                    <i class="fas fa-home me-2"></i>
                    Go to Home
                </a>
                <a href="/user-dashboard" class="add-user-btn text-decoration-none d-inline-flex align-items-center">
                    <i class="fas fa-ticket-alt me-2"></i>
                    View My Bookings
                </a>
            </div>
        }
    </div>
</div>

@code {
    private User user { get; set; }
    private bool loading = true;
    private string error = null;
    private string userId = null;
    private int totalBookings = 0;
    private int confirmedBookings = 0;
    private int cancelledBookings = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get user ID from localStorage
            userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            if (string.IsNullOrEmpty(userId))
            {
                Nav.NavigateTo("/login?returnUrl=/profile");
                return;
            }

            // Load user details
            var query = new GetUserByIdQuery(userId);
            user = await Mediator.Send(query);

            if (user == null)
            {
                error = "User not found.";
                loading = false;
                return;
            }

            // Load booking statistics
            await LoadBookingStatistics();
        }
        catch (Exception ex)
        {
            error = $"Error loading profile: {ex.Message}";
            Console.WriteLine($"UserProfile Error: {ex}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadBookingStatistics()
    {
        try
        {
            var bookings = await Db.Bookings
                .Find(b => b.UserId == userId)
                .ToListAsync();

            totalBookings = bookings.Count;
            confirmedBookings = bookings.Count(b => b.Status == BookingStatus.Confirmed);
            cancelledBookings = bookings.Count(b => b.Status == BookingStatus.Cancelled);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading booking statistics: {ex.Message}");
        }
    }

    private string GetRoleName(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "Super Admin",
            UserRole.Admin => "Admin",
            UserRole.ZonalManager => "Zonal Manager",
            UserRole.Customer => "Customer",
            _ => role.ToString()
        };
    }

    private string GetRoleBadgeClass(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "role-badge-super",
            UserRole.Admin => "role-badge-admin",
            UserRole.ZonalManager => "role-badge-manager",
            UserRole.Customer => "role-badge-customer",
            _ => "meta-badge"
        };
    }

    private void GoToHome()
    {
        Nav.NavigateTo("/");
    }
}
